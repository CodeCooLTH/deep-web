generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(uuid())
  displayName        String
  username           String   @unique
  avatar             String?
  phone              String?  @unique
  email              String?  @unique
  trustScore         Int      @default(0)
  isShop             Boolean  @default(false)
  isAdmin            Boolean  @default(false)
  passwordHash       String?
  // successfulBidCount: cached count "bid สำเร็จ" (ชนะ auction + Order ไม่ถูก cancel) — ใช้คำนวณ User Level ladder runtime (feature 00002)
  successfulBidCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  authAccounts           AuthAccount[]
  mobileAuthTickets      MobileAuthTicket[]
  shops                  Shop[] // Phase 2 cutover (feature 00008 §4/§6.3) — เดิมเป็น `shop Shop?` (1:1); ตอนนี้ 1 user มีได้หลาย Shop (PERSONAL 1 แถว unique partial + BUSINESS หลายแถว) ใช้ .find(kind==='PERSONAL')/.filter ตามต้องการที่ caller
  verifications          VerificationRecord[]
  userBadges             UserBadge[]
  trustScoreHistory      TrustScoreHistory[]
  ordersAsBuyer          Order[]                 @relation("BuyerOrders")
  customer               Customer? // feat 00014 — link Customer เมื่อสมัครเป็น buyer (Phase 2; nullable)
  reviewsGiven           Review[]                @relation("ReviewerReviews")
  verificationsReviewed  VerificationRecord[]    @relation("ReviewedBy")
  topUpRequestsReviewed  TopUpRequest[]          @relation("TopUpReviewedBy")
  scamReports            ScamReport[]            @relation("ScamReporter")
  scamReportsReviewed    ScamReport[]            @relation("ScamReviewer")
  appointmentReschedules AppointmentReschedule[] @relation("AppointmentRescheduleActor") // feature 00024

  // --- Buyer App (auction domain — additive, mobile-only) ---
  bids          Bid[]          @relation("UserBids")
  watchList     WatchList[]    @relation("UserWatches")
  notifications Notification[] @relation("UserNotifications")
  pushTokens    PushToken[]    @relation("UserPushTokens")
  bidReactions  BidReaction[]  @relation("UserBidReactions")

  // --- Deep Stock Pro (feature 00009) ---
  stockMovementsActedOn StockMovement[] @relation("StockMovementActor")

  // --- Business Account & Packages (feature 00008, Phase 1 additive) ---
  shopMemberships             ShopMember[]
  businessPackageSubscription BusinessPackageSubscription?
  sentShopInvites             ShopInvite[]                 @relation("ShopInviteInvitedBy")
  acceptedShopInvites         ShopInvite[]                 @relation("ShopInviteAcceptedBy")
  createdShopInviteLinks      ShopInviteLink[]             @relation("ShopInviteLinkCreatedBy") // NEW (feature 00012)

  // --- Deep Chat (feature 00011, additive) ---
  buyerConversations Conversation[] @relation("BuyerConversations") // conversation ที่ user เป็นฝั่ง buyer
  sentChatMessages   ChatMessage[]  @relation("SentChatMessages") // ข้อความที่ user ส่ง (buyer หรือ seller)

  // --- Expense & Cost Tracking (feature 00016, additive) ---
  createdExpenses  Expense[]       @relation("ExpenseCreatedBy") // NEW — back-relation ของ Expense.createdByUserId (Prisma-managed, ไม่มีคอลัมน์จริงฝั่งนี้)
  aiSettingUpdates ShopAiSetting[] // NEW (feature 00019) — การตั้งค่า AI ที่ผู้ใช้นี้แก้ล่าสุด

  // --- feature 00023 Chat Auto-Reply (additive) ---
  // back-relation ของ AutoReplyConfig.updatedByUserId เท่านั้น — createdByUserId/updatedByUserId
  // ของ AutoReplyKeyword/AutoReplyRule และ testModeEnabledByUserId ของ AutoReplyConfig เป็น
  // String ดิบไม่มี FK ตาม DATABASE.md §3 (audit เบา ไม่ผูก relation)
  autoReplyConfigUpdates AutoReplyConfig[] @relation("AutoReplyConfigUpdatedBy")
}

model AuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model MobileAuthTicket {
  id        String    @id @default(uuid())
  userId    String
  purpose   String // 'enter' | 'exchange'
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Shop {
  id            String   @id @default(uuid())
  // userId: owner-at-creation (immutable). Phase 2 cutover (feature 00008 §4/§6.3) ทำแล้ว — ตัด
  // `@unique` ออกจาก field นี้ (Prisma-managed) เพราะ 1 user ตอนนี้มีได้หลาย Shop (PERSONAL + BUSINESS
  // หลายแถว) ความ unique จริงอยู่ที่ระดับ "PERSONAL shop ต่อ user มีได้ 1 แถว" เท่านั้น ซึ่งบังคับด้วย
  // 🛑 partial unique index `Shop_userId_personal_key` ON "Shop"("userId") WHERE "kind" = 'PERSONAL'
  // (migration `20260702000002_business_account_packages_owner_cutover`) — เป็น unmanaged SQL ที่
  // Prisma DSL ประกาศไม่ได้ (ไม่รองรับ partial index) ห้าม `prisma db pull`/`migrate dev` เด็ดขาด
  // หลัง Phase 2 apply เพราะ introspection จะไม่เห็น partial index นี้แล้วพยายาม "แก้ให้ตรง schema"
  // ซึ่งอาจ DROP มันทิ้ง (ดู DATABASE.md feature 00008 §4/§9-1, memory project_shared_db_drift_no_migrate_dev)
  userId        String
  shopName      String
  description   String?
  logo          String?
  // coverImage (user 2026-07-25): ภาพหน้าปกร้าน — ใช้เป็นภาพนำของหน้าลิงก์คำสั่งซื้อ /o/[token]
  // ที่ผู้ซื้อเปิดจากแชท (จุดที่ต้องพิสูจน์ว่าร้านมีตัวตนจริงก่อนขอให้ล็อกอิน)
  // null = ยังไม่ได้อัปโหลด → UI fallback ไปใช้ logo ขยายเบลอแทน ไม่ปล่อยพื้นที่ว่าง
  coverImage    String?
  category      String? // LEGACY single-value — คงไว้ระหว่าง migration (backward-compat); SSOT ใหม่ = categories
  categories    String[] @default([]) // multi-category ≤5 (feature 00001); GIN index ใน migration SQL
  salesChannels String[] @default([]) // ช่องทางการขาย: facebook/offline/line/tiktok_shop/lazada/shopee; validate app layer
  slug          String?  @unique // public shop URL /{slug}; nullable จนกว่าจะตั้งใน onboarding (P3)
  address       String?
  latitude      Float? // พิกัดร้าน (feature 00001 onboarding map pin); ไทย 5-21N validate app layer
  longitude     Float? // พิกัดร้าน; ไทย 97-106E validate app layer
  // businessType: LEGACY (ก่อน feature 00008) — label ประเภทนิติบุคคลสำหรับ L3 verification
  // ("INDIVIDUAL" ฯลฯ) — ⚠️ ไม่ใช่สิ่งเดียวกับ `kind` ด้านล่าง ห้ามสับสน/reuse (ดู DATABASE.md §3.2 warning)
  businessType  String   @default("INDIVIDUAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- feature 00008: Business Account & Packages (Phase 1, additive) ---
  // kind: "PERSONAL" | "BUSINESS" — String (มิเรอร์ Product.type/Order.type pattern, ไม่ใช่ lifecycle-state)
  // default PERSONAL = ทุก Shop เดิมก่อน feature นี้ถือเป็น PERSONAL อัตโนมัติ (BR-BIZ-25 zero-regression)
  kind              String    @default("PERSONAL")
  // packageLockedAt/packageLockReason: read-only lock state ของ BUSINESS shop เท่านั้น
  // NULL เสมอสำหรับ PERSONAL shop — ตั้งเมื่อ owner's BusinessPackageSubscription = LOCKED_RENEWAL_FAILED
  // หรือ quota เกิน (RENEWAL_FAILED | OWNER_CANCELLED_PACKAGE | QUOTA_EXCEEDED_BUSINESS_COUNT |
  // QUOTA_EXCEEDED_ADMIN_COUNT — 2 ค่าแรก grace-eligible นับถอย 30 วัน, 2 ค่าหลังไม่มี grace)
  packageLockedAt   DateTime?
  packageLockReason String?
  // deletedAt/deletedReason: soft-delete ("OWNER_DELETED" | "PACKAGE_LAPSED") — NULL เสมอสำหรับ PERSONAL;
  // restore ได้ภายใน 30 วันหลัง deletedAt (grace ก่อน purge)
  deletedAt         DateTime?
  deletedReason     String?
  // purgedAt: tombstone marker หลัง retention 30 วัน — 🛑 ไม่ใช่ physical DELETE (RD-11, DATABASE.md §12.5)
  // FK Order.shopId เป็น Restrict (มี Order ค้างจะลบไม่ได้) + Hard Rule ห้าม drop ข้อมูลเว้นแต่สั่งชัด —
  // row ยังอยู่ครบ แค่ถูก exclude จากทุก list/quota/switcher ถาวรที่ app layer
  purgedAt          DateTime?

  // trustScore: Business Reputation (feature 00008 Phase 5, P5-3) — คะแนน trust ของ BUSINESS shop เอง
  // (แยกจาก User.trustScore ของ owner). PERSONAL shop ไม่ใช้ field นี้ (คง 0 default เสมอ — personal
  // ยังคำนวณ/แสดงผ่าน User.trustScore เดิม, service เดิมไม่แตะ field นี้). recalc โดย
  // recalculateShopTrustScore(shopId) (P5-3b, service layer) — monotonic rule (Math.max) เหมือน user เดิม
  trustScore Int @default(0)

  // --- Pin Products (feature 00013, additive) ---
  // pinSlots: จำนวน slot ปักหมุดที่ร้านมีสิทธิ์ใช้พร้อมกัน. ทุกร้านเริ่ม 1 (free slot, BR-PIN-01);
  // ซื้อเพิ่มถาวรทีละ 1 ที่ ฿99 ผ่าน SellerWallet (BR-PIN-02); ไม่มี downgrade ใน MVP (BR-PIN-03).
  // 🛑 invariant "count(Product.pinnedAt ไม่ null ต่อ shop) <= pinSlots" enforce ที่ service layer
  // เท่านั้น (atomic เหมือน wallet.service) — DB ไม่มี cross-row CHECK แบบนี้.
  // CHECK(pinSlots >= 1) enforce ด้วยมือใน migration SQL (NOT VALID+VALIDATE เพราะ Shop มี row จริงบน prod)
  pinSlots Int @default(1)

  // --- feature 00011 ext #2: Response-rate / Response-time Trust Metric (additive, nullable) ---
  // denormalized จาก Deep Chat (Conversation/ChatMessage) เขียนโดย cron รายวัน
  // (`/api/cron/chat-response-metrics`, S-24) — เลือกอ่านสด null จนกว่า cron รอบแรกจะรัน
  // หรือ sample-size ไม่ถึงเกณฑ์ (FR-RESP-04, gate ≥3) ไม่ query สดตอน render public profile
  chatResponseRate       Float? // response rate % (0-100), FR-RESP-02; null = ยังไม่พอ sample
  chatResponseSampleSize Int? // denominator รอบล่าสุด (จำนวน conversation ใน window 90 วัน), FR-RESP-01
  chatMedianResponseSec  Int? // median เวลาตอบ (วินาที) เฉพาะ conv ที่ตอบแล้ว, FR-RESP-03
  chatMetricsUpdatedAt   DateTime? // เวลาที่ cron เขียนล่าสุด, FR-RESP-07

  // --- Expense & Cost Tracking (feature 00016, additive) ---
  // staffCanViewFinance: toggle owner เปิด/ปิดให้ ShopMember(role=ADMIN) เห็นข้อมูล Expense/P&L ของร้านนี้
  // default false เสมอ (FR-EXP-10-AC-01, BR §3.6 — "ข้อมูลการเงินคือความลับทางธุรกิจระดับสูงสุด")
  // มีผลจริงเฉพาะ BUSINESS shop ในทางปฏิบัติ (PERSONAL shop ไม่มี ShopMember(ADMIN) อื่นอยู่แล้ว —
  // 1 user = owner คนเดียว) แต่ประกาศไว้ทุกแถวเพื่อความสม่ำเสมอของ schema (PRD §4.2)
  // 🛑 ไม่ใช่ authorization gate เอง — แค่ data flag; service layer ต้องเช็ค role+toggle+package
  // ครบทุกครั้ง (ดู SRS สำหรับ authorization logic เต็ม)
  staffCanViewFinance Boolean @default(false)
  // --- feature 00017: Lodging Vertical (Phase 1, additive) ---
  // vertical: "GENERAL" (สินค้าและบริการ — ecommerce เดิม) | "LODGING" (บ้านพักตากอากาศ)
  // String ตาม convention เดิม (มิเรอร์ kind/type/status) ไม่ใช่ Prisma enum
  // default GENERAL = Shop เดิมทุกแถวก่อน feature นี้เป็น ecommerce อัตโนมัติ ไม่ต้อง backfill (BR-LODG-01/03)
  //
  // 🛑 คนละเรื่องกับ 3 field ที่ชื่อคล้ายกัน ห้าม reuse ห้ามเขียนค่าข้ามกัน (BR-LODG-04):
  //   - businessType (บรรทัด ~99) = INDIVIDUAL|COMPANY ป้ายนิติบุคคลสำหรับ L3 verification
  //   - kind         (บรรทัด ~106) = PERSONAL|BUSINESS ระดับบัญชี (feature 00008)
  //   - category/categories        = หมวดสินค้า 10 key (src/lib/shop-categories.ts)
  // ป้ายบนหน้าจอ: vertical = "ประเภทกิจการ", businessType = "ประเภทผู้ประกอบการ"
  //
  // 🛑 immutable — ตั้งครั้งเดียวตอนสร้างธุรกิจ เปลี่ยนภายหลังไม่ได้ (BR-LODG-30, D-01)
  // บังคับที่ service layer เท่านั้น (ไม่มี DB trigger — โครงการไม่ใช้ trigger ที่ไหนเลย)
  // service ที่แก้ข้อมูลร้านต้องไม่รับ field นี้เข้ามาเลย
  vertical            String  @default("GENERAL")

  // appointmentGranularity: หน่วยเวลาของการนัด (feature 00024 FR-RSV-13) — DAY | TIME
  //   DAY  = รับนัดเป็นรายวัน ฟอร์มไม่ถามเวลาเริ่ม/สิ้นสุด (ค่าเริ่มต้น — กรอกน้อยที่สุด)
  //   TIME = ระบุช่วงเวลา เช่น 09:00-12:00
  //
  // IMPORTANT: เป็นแค่ค่าที่บอกว่า "ฟอร์มควรถามอะไร" (BR-RSV-55) — เปลี่ยนค่านี้ต้องไม่แตะ
  //   นัดที่บันทึกไว้แล้วแม้แต่แถวเดียว ทั้งสองโหมดเก็บด้วย Order.serviceStart/serviceEnd
  //   ชุดเดียวกัน โหมด DAY เก็บเป็นช่วงที่ครอบทั้งวันตามเวลาไทย ไม่มี flag แยก (BR-RSV-54)
  //   การแสดงผลตัดสินจากข้อมูลจริงของแถวนั้น ไม่ใช่จากค่านี้ (BR-RSV-57)
  // CHECK: appointmentGranularity IN ('DAY','TIME')
  appointmentGranularity String @default("DAY")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms                Room[] // NEW (feature 00017 P1) — ห้องพัก; ว่างเสมอสำหรับ shop ที่ vertical = GENERAL
  housekeepers         Housekeeper[] // NEW (feature 00017 P3) — รายชื่อแม่บ้าน; ว่างเสมอสำหรับ GENERAL
  serviceResources     ServiceResource[] // NEW (feature 00024) — ทรัพยากรที่จองเวลาได้; ว่างเสมอถ้าไม่เข้า BR-RSV-01
  products             Product[]
  orders               Order[]
  wallet               SellerWallet?
  topUpRequests        TopUpRequest[]
  auctions             Auction[]
  inventoryEntitlement InventoryEntitlement?
  stockMovements       StockMovement[] // Deep Stock Pro (feature 00009) — denormalized scope
  members              ShopMember[] // NEW (feature 00008)
  invites              ShopInvite[] // NEW (feature 00008)
  inviteLinks          ShopInviteLink[] // NEW (feature 00012) — reusable staff invite link
  videos               ShopVideo[] // คลิปที่ร้านเลือกโชว์บนหน้าร้านสาธารณะ (2026-07-26)
  conversations        Conversation[] // Deep Chat (feature 00011) — บทสนทนาที่ shop นี้เป็นคู่สนทนา
  channels             ShopChannel[] // Facebook/Instagram chat integration (feature 00018) — Page/IG ที่ร้านผูกไว้
  quickMessages        QuickMessage[] // ข้อความสำเร็จรูป (feature 00018 composer #2) — ระดับร้าน ทุกคนในร้านใช้ร่วมกัน
  chatGroups           ChatGroup[] // กลุ่ม/แท็บจัดหมวดแชท (feature 00018) — ร้านตั้งเอง เช่น ทั่วไป/ร้านอะไหล่/ไม่สนใจ
  verifications        VerificationRecord[]  @relation("ShopVerifications") // NEW (feature 00008 Phase 5, P5-1) — Business-scope verification (NULL shopId = personal/user-level เดิมยังอยู่ใน User.verifications)
  badges               UserBadge[] // NEW (feature 00008 Phase 5, P5-2) — Business-scope badge (NULL shopId = personal/buyer badge เดิมยังอยู่ใน User relation)
  trustScoreHistory    TrustScoreHistory[] // NEW (feature 00008 Phase 5, P5-3) — Business-scope trust score history (NULL shopId = personal/user-level เดิมยังอยู่ใน User.trustScoreHistory)
  expenses             Expense[] // NEW (feature 00016) — ค่าใช้จ่ายดำเนินธุรกิจของร้านนี้
  aiSetting            ShopAiSetting? // NEW (feature 00019) — ตั้งค่าผู้ช่วยร่างคำตอบ AI ของร้านนี้ (1:1)
  aiSuggestDailyUsages AiSuggestDailyUsage[] // NEW (feature 00019 ext 2026-07-29) — ตัวนับโควตาฟรี ai-suggest ต่อวัน (เฉพาะร้าน non-paid, ≤1 แถวต่อวัน)
  aiSuggestUsageEvents AiSuggestUsageEvent[] // NEW (feature 00019 ext 2026-07-29) — audit log ai-suggest ทุก path (FREE/CREDIT/UNLIMITED_PLAN)
  shippingAccount      ShopShippingAccount? // NEW (feature 00022) — การเชื่อมต่อขนส่ง iShip + ค่าตั้งต้น (1:1, เฉพาะ vertical=GENERAL)
  orderShipments       OrderShipment[] // NEW (feature 00022) — พัสดุที่ร้านนี้เปิดกับขนส่ง (denorm scope)
  shipmentPickups      ShipmentPickup[] // NEW (feature 00022) — คำขอเรียกรถเข้ารับ (ระดับร้าน ไม่ใช่ระดับออเดอร์)

  // --- feature 00023 Chat Auto-Reply (additive) ---
  autoReplyConfig   AutoReplyConfig? // การตั้งค่าระดับร้าน (1:1)
  autoReplyKeywords AutoReplyKeyword[] // กลุ่มคำของร้านนี้
  autoReplyRules    AutoReplyRule[] // กฎคำตอบของร้านนี้ (ทุกระดับ)
  autoReplyJobs     AutoReplyJob[] // คิวงานตอบอัตโนมัติ scope ร้านนี้
  autoReplyLogs     AutoReplyLog[] // บันทึกการตัดสินใจ scope ร้านนี้
  // feature 00023 phase 00023-qna (2026-07-31)
  autoReplyQnas               AutoReplyQna[] // คลังคำถาม-คำตอบ (ผูกกลุ่มคำ; shopId ไว้ query เร็ว)
  autoReplyUnansweredQuestions AutoReplyUnansweredQuestion[] // คิวคำถามที่บอทตอบไม่ได้
  autoReplyGuardrails         AutoReplyGuardrail[] // กฎห้ามตอบของ AI Enhance (ผูกกลุ่มคำ; shopId ไว้ query เร็ว)
  aiChatbotTestThreads        AiChatbotTestThread[] // แชทที่ใช้ทดสอบ ChatBot (มีผลตอน status=TEST)

  // GIN index สำหรับค้น multi-category/sales-channel (เดิมสร้างด้วย raw SQL ใน migration
  // 20260618035221 → prisma มองไม่เห็นเลย auto-gen DROP ทุกครั้ง). ประกาศใน schema ให้ prisma จัดการ
  @@index([categories], type: Gin, map: "Shop_categories_gin_idx")
  @@index([salesChannels], type: Gin, map: "Shop_salesChannels_gin_idx")
  @@index([userId, kind], map: "Shop_userId_kind_idx") // NEW — switcher/owner lookup ครอบคลุมทั้ง 2 kind
  @@index([kind, packageLockedAt], map: "Shop_kind_packageLockedAt_idx") // NEW — Admin/Ops list locked business (FR-BIZ-24)
  @@index([kind, packageLockReason, packageLockedAt], map: "Shop_kind_lockReason_lockedAt_idx") // NEW — cron: auto-soft-delete lapsed grace
  @@index([deletedAt, purgedAt], map: "Shop_deletedAt_purgedAt_idx") // NEW — cron: purge expired retention
  @@index([vertical], map: "Shop_vertical_idx") // NEW (feature 00017) — กรองธุรกิจตามประเภทกิจการ
}

// Room — ห้องพักที่เปิดให้จอง (feature 00017 Lodging Vertical, Phase 1)
// "ห้อง" = หน่วยที่ให้จอง ซึ่งอาจเป็นห้องเดี่ยวหรือทั้งหลัง
// มีได้เฉพาะ Shop ที่ vertical = "LODGING" (บังคับที่ service layer — DB ไม่มี cross-table CHECK)
//
// Phase 2 จะเพิ่ม Order.roomId (FK, ON DELETE RESTRICT) → ห้ามลบห้องที่มีการจอง (BR-LODG-06)
// ระหว่าง P1 ยังไม่มี relation นั้น แต่ห้ามเผลอเพิ่ม onDelete: Cascade ทีหลัง
model Room {
  id            String   @id @default(uuid())
  shopId        String
  name          String
  description   String?  @db.Text
  // images: array ของ fileId (จาก /api/upload) เรียงตามลำดับแสดงผล — ตัวแรก = รูปหลัก
  // มิเรอร์ Product.images ที่เป็น Json อยู่แล้ว (ไม่แยกตาราง RoomImage เพราะมีเพดาน 10 รูป
  // และไม่มี query ที่ต้อง join รูปเดี่ยว). เพดาน 10 บังคับที่ app layer (BR-LODG-34, D-05)
  images        Json     @default("[]")
  // pricePerNight: ราคาต่อคืน — Decimal(12,2) ให้ตรงกับ Order.totalAmount/Product.price เดิม
  // CHECK(pricePerNight > 0) ใน migration SQL (BR-LODG-05)
  pricePerNight Decimal  @db.Decimal(12, 2)
  maxGuests     Int?
  // facilities: key สิ่งอำนวยความสะดวก (src/lib/lodging.ts ROOM_FACILITIES) validate ที่ app layer
  // มิเรอร์ Shop.categories ที่เป็น String[] อยู่แล้ว — ไม่ทำตาราง lookup เพราะเป็นค่าคงที่ที่แอปกำหนด
  facilities    String[] @default([])
  // depositMode/depositValue: มัดจำเริ่มต้นของห้อง (BR-LODG-15, D-03)
  //   FIXED   → depositValue = จำนวนบาท
  //   PERCENT → depositValue = เปอร์เซ็นต์ของยอดรวม (0-100)
  // depositValue = 0 หมายถึง "ไม่เก็บมัดจำ" (BR-LODG-17) → flow ข้ามขั้นแนบสลิปทั้งหมด
  // 🛑 ค่านี้เป็นแค่ "ค่าเริ่มต้น" — ยอดจริงของแต่ละการจอง snapshot ไว้ที่ Order.depositAmount (P2)
  //    ห้ามให้การจองอ้างอิงค่านี้สด มิฉะนั้นยอดของการจองเก่าจะขยับตามเมื่อเจ้าของแก้ห้อง (BR-LODG-18)
  // CHECK: depositMode IN ('FIXED','PERCENT') + depositValue >= 0 + (PERCENT → <= 100)
  depositMode   String   @default("FIXED")
  depositValue  Decimal  @default(0) @db.Decimal(12, 2)
  // isActive: ปิดการใช้งาน = ไม่ให้สร้างการจองใหม่ + ไม่โชว์บนโปรไฟล์สาธารณะ
  // แต่การจองเดิมยังเปิดดูได้ครบ (BR-LODG-07) — แยก "หยุดขาย" ออกจาก "ลบประวัติ"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[] // การจองของห้องนี้ (Phase 2) — FK ฝั่ง Order เป็น Restrict ห้ามลบห้องที่มีการจอง

  @@index([shopId, isActive], map: "Room_shopId_isActive_idx") // list ห้องของร้าน + กรองเฉพาะที่เปิดใช้งาน
}

// Housekeeper — แม่บ้าน/ผู้ดูแลความสะอาด (feature 00017 Lodging Vertical, Phase 3)
//
// 🛑 ไม่ใช่ผู้ใช้ในระบบ (BR-LODG-24) — ไม่มี userId, ไม่มี relation ไป User โดยเจตนา
// การเพิ่ม FK ไป User จะเปิดช่องให้เข้าใจผิดว่าต่อไปจะให้แม่บ้านล็อกอินได้
// เป็นเพียง "รายชื่อ" ที่เจ้าของบันทึกไว้เพื่อมอบหมายงาน — ไม่มีหน้าจอ ไม่มีสิทธิ์เข้าถึงใด ๆ
//
// 🛑 name/phone เป็น PII ของบุคคลที่สาม — ห้ามส่งข้ามไปฝั่งผู้จองทุกกรณี (BR-LODG-23)
// ตัดที่ server boundary ก่อน serialize ไม่ใช่แค่ไม่แสดงผล
model Housekeeper {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  // phone ไม่ unique — ไม่ใช่ตัวระบุตัวตนกลาง เป็นข้อมูลติดต่อภายในร้าน คนละคนใช้เบอร์เดียวกันได้
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[] // การจองที่มอบหมายให้แม่บ้านคนนี้ — FK ฝั่ง Order เป็น SET NULL

  @@index([shopId, isActive], map: "Housekeeper_shopId_isActive_idx") // list แม่บ้านของร้าน
}

// ServiceResource: สิ่งที่ลูกค้าจองเวลาเข้ามาใช้ — feature 00024
// เช่น ช่างหนึ่งคน / เตียงนวดหนึ่งเตียง / ห้องสตูดิโอ / คลาสเรียน / ชุดอุปกรณ์ให้เช่า
// ว่างเสมอสำหรับ shop ที่ไม่เข้าเงื่อนไข BR-RSV-01 (ต้อง kind=BUSINESS "และ" vertical=GENERAL)
model ServiceResource {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  description String? @db.Text

  // durationMinutes: ระยะเวลาบริการมาตรฐาน (นาที) — เป็น "ค่าตั้งต้นช่วยกรอก" เท่านั้น (BR-RSV-09)
  // 🛑 ห้ามให้การนัดอ้างอิงค่านี้สด — นัดแต่ละครั้ง snapshot ช่วงเวลาจริงไว้ที่ Order.serviceStart/End
  //    มิฉะนั้นเวลาของนัดเก่าจะขยับเองเมื่อเจ้าของแก้ค่ามาตรฐาน (บทเรียนเดียวกับ Room.depositMode)
  durationMinutes Int?

  // capacity: จำนวนนัดที่รับได้พร้อมกันในช่วงเวลาที่ทับกัน (BR-RSV-06) — CHECK(capacity >= 1)
  // 🛑 ค่านี้ไม่ได้ถูกบังคับโดย EXCLUDE constraint โดยตรง — constraint บังคับแค่ "ที่นั่งเดียวกัน
  //    ห้ามเวลาทับกัน" ส่วนเพดานจำนวนที่นั่งบังคับที่ service layer ด้วยการวนลอง seat 1..capacity
  //    (ดู src/services/appointment.service.ts) — ปลอดภัยเพราะ seat ที่เกิน capacity ไม่มีวันถูกลอง
  capacity Int @default(1)

  // depositMode/depositValue: มัดจำเริ่มต้นของทรัพยากรนี้ (BR-RSV-43/44/45)
  //   FIXED   → depositValue = จำนวนบาท
  //   PERCENT → depositValue = เปอร์เซ็นต์ของยอดรวมออเดอร์ (0-100)
  // depositValue = 0 หมายถึง "ไม่เก็บมัดจำ" (BR-RSV-44) → ไม่แสดงส่วนมัดจำในทุก surface
  // 🛑 ค่านี้เป็นแค่ "ค่าตั้งต้นช่วยกรอก" — ยอดจริงของแต่ละนัด snapshot ไว้ที่ Order.depositAmount
  //    ห้ามให้ออเดอร์อ้างอิงค่านี้สด มิฉะนั้นยอดของออเดอร์เก่าจะขยับเมื่อเจ้าของแก้ทรัพยากร (BR-RSV-46)
  //    เหตุผลเดียวกับ durationMinutes ด้านบน
  // 🛑 มัดจำ "ไม่กั้น" การกันคิว — ไม่มีสถานะรอชำระ ไม่มีสลิป (BR-RSV-49/50)
  //    ต่างจาก Room.depositMode ของ 00017 ที่ depositValue > 0 บังคับ flow แนบสลิปก่อนยืนยัน
  //    อย่าลอก flow นั้นมาเพราะเห็นว่าใช้ Order.depositAmount ฟิลด์เดียวกัน
  // CHECK: depositMode IN ('FIXED','PERCENT') + depositValue >= 0 + (PERCENT → <= 100)
  depositMode  String  @default("FIXED")
  depositValue Decimal @default(0) @db.Decimal(12, 2)

  // isActive: ปิดการใช้งาน = ไม่รับนัดใหม่ แต่นัดเดิมยังอยู่ครบ (BR-RSV-07)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[] // นัดของทรัพยากรนี้ — FK ฝั่ง Order เป็น Restrict ห้ามลบทรัพยากรที่มีนัด (BR-RSV-08)

  @@index([shopId, isActive], map: "ServiceResource_shopId_isActive_idx")
}

// AppointmentReschedule: ประวัติการเลื่อนนัด — feature 00024
// แยกตารางเพราะ BR-RSV-30 บังคับให้ "สะสมทุกครั้ง ไม่ทับของเดิม"
// ใช้เป็นแหล่งนับจำนวนครั้งที่เลื่อนต่อออเดอร์/ต่อลูกค้า (FR-RSV-11) — ไม่มี counter column
model AppointmentReschedule {
  id      String @id @default(uuid())
  orderId String

  // สถานะก่อนเลื่อน (snapshot) — เก็บครบเพื่อให้ย้อนอ่านได้ว่าเดิมนัดไว้ตรงไหน
  fromResourceId String?
  fromStart      DateTime @db.Timestamptz(3)
  fromEnd        DateTime @db.Timestamptz(3)

  // สถานะหลังเลื่อน
  toResourceId String?
  toStart      DateTime @db.Timestamptz(3)
  toEnd        DateTime @db.Timestamptz(3)

  // actorRole: "SHOP" | "BUYER" — ใครเป็นต้นเหตุของการเลื่อนนี้
  // ลูกค้า "ขอ" ได้แต่เปลี่ยนเองไม่ได้ (BR-RSV-23) → การย้ายเวลาจริงบันทึกเป็น SHOP เสมอ
  // พร้อม reason ที่ลูกค้าให้ไว้ ถ้าเป็นการอนุมัติคำขอของลูกค้า
  actorRole   String
  actorUserId String?
  reason      String?  @db.Text
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("AppointmentRescheduleActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt], map: "AppointmentReschedule_orderId_createdAt_idx")
}

model VerificationRecord {
  id             String    @id @default(uuid())
  userId         String
  // shopId: Business Reputation (feature 00008 Phase 5, P5-1) — nullable FK → Shop.
  // NULL = user/personal-level เดิม (backward-compat, zero-regression Personal shop);
  // non-NULL = verification ผูก Business shop โดยตรง (แยกจาก owner). ON DELETE SET NULL
  // (ลบ shop ไม่ลบ verification — กลายเป็น orphan user-level record แทน)
  shopId         String?
  type           String
  level          Int
  status         String    @default("PENDING")
  documents      Json?
  rejectedReason String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop       Shop? @relation("ShopVerifications", fields: [shopId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([shopId])
}

// รายงานมิจฉาชีพ (1 เคส) — spec 2026-06-20-scam-risk-check-report
// แสดงผลแบบ "จำนวน" ไม่ตัดสิน; นับเฉพาะ status=APPROVED (admin ตรวจหลักฐานแล้ว)
model ScamReport {
  id             String    @id @default(uuid())
  reporterId     String
  status         String    @default("PENDING") // PENDING / APPROVED / REJECTED
  scamType       String // TRANSFER_NO_DELIVERY / ITEM_NOT_AS_DESCRIBED / FAKE_INVESTMENT / OTHER
  amountLost     Int       @default(0) // มูลค่าความเสียหาย (บาท)
  description    String    @db.Text
  evidence       Json      @default("[]") // fileId[] จาก /api/upload (บังคับ ≥1)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reporter    User                   @relation("ScamReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy  User?                  @relation("ScamReviewer", fields: [reviewedById], references: [id])
  identifiers ScamReportIdentifier[]

  @@index([status])
}

// ตัวระบุของรายงาน (1 รายงานมีได้หลายตัว). บัตรปชช./บัญชี เก็บ HMAC เท่านั้น (PDPA)
model ScamReportIdentifier {
  id          String  @id @default(uuid())
  reportId    String
  type        String // PHONE / NAME / NATIONAL_ID / BANK_ACCOUNT
  valueHash   String // HMAC-SHA256 ของค่าที่ normalize แล้ว (คีย์ค้นหา exact-match)
  valueMasked String // สำหรับแสดงผลแบบ mask — ไม่เปิดเผยค่าเต็ม
  bankName    String? // เฉพาะ BANK_ACCOUNT

  report ScamReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([type, valueHash])
}

model Badge {
  id        String   @id @default(uuid())
  name      String
  nameEN    String   @unique
  icon      String?
  imageUrl  String?
  type      String
  criteria  Json
  audience  String   @default("SELLER")
  createdAt DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  // shopId: NULL = user-level badge (buyer badge หรือ personal-seller badge เดิม — zero-regression);
  // non-NULL = Business shop badge (feature 00008 Phase 5, P5-2) แยก achievement ของ shop ออกจาก user
  shopId   String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  // onDelete Cascade: business shop ถูกลบ → badge ของ business นั้นไม่มีความหมายอีกต่อไป (achievement
  // ผูกกับ shop โดยตรง ต่างจาก VerificationRecord.shopId ที่ SET NULL เพราะยังอ้างอิงกลับเป็น user-level ได้)
  shop  Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // 🛑 @@unique([userId, badgeId]) เดิมถูกถอดออก — เปลี่ยนเป็น partial unique index 2 ตัวแทน เพราะ nullable
  // shopId ทำให้ Postgres treat NULL เป็น distinct (personal badge ซ้ำได้ถ้าใช้ unique เดิมตรง ๆ):
  //   - `UserBadge_userId_badgeId_personal_key` ON ("userId","badgeId") WHERE "shopId" IS NULL (บังคับ
  //     personal/buyer badge เดิม — 1 badge ต่อ user)
  //   - `UserBadge_shopId_badgeId_key` ON ("shopId","badgeId") WHERE "shopId" IS NOT NULL (บังคับ
  //     business badge — 1 badge ต่อ business shop)
  // Prisma DSL ไม่รองรับ partial index → enforced เป็น unmanaged SQL ใน migration
  // `20260703000100_add_userbadge_shopid` เท่านั้น ห้าม `prisma migrate dev`/`db pull` (ดู
  // memory `project_shared_db_drift_no_migrate_dev`, precedent `Shop_userId_personal_key`)
  @@index([shopId])
}

model Product {
  id                String    @id @default(uuid())
  shopId            String
  name              String
  sku               String? // รหัสสินค้า (optional; feature 00001 onboarding product form)
  description       String?   @db.Text
  shortDescription  String?   @db.VarChar(200)
  attributes        Json      @default("{}")
  price             Decimal   @db.Decimal(12, 2)
  images            Json      @default("[]")
  type              String    @default("PHYSICAL")
  // capability flags (P1 — spec 2026-05-10)
  fulfillmentMode   String    @default("SHIPPED")
  billingMode       String    @default("ONE_TIME")
  billingPeriod     String?
  billingPeriodDays Int?
  isActive          Boolean   @default(true)
  // stockQty: Inventory Add-on (feature 00003) — NULL = untracked (opt-in, BR-INV-10), non-NULL >=0 = tracked.
  // CHECK(stockQty >= 0) enforce ใน migration SQL ด้วยมือ (NOT VALID + VALIDATE เพราะ table มี row จริง)
  stockQty          Int?
  // lowStockThreshold: Deep Stock Pro (feature 00009) — NULL=ไม่ตั้ง alert, N>=0=ตั้งค่า. PRO-only gate ที่ app layer.
  // CHECK(lowStockThreshold IS NULL OR lowStockThreshold >= 0) enforce ใน migration SQL ด้วยมือ (NOT VALID + VALIDATE)
  lowStockThreshold Int?
  // pinnedAt: Pin Products (feature 00013) — non-NULL = สินค้าถูกปักหมุด, เรียงแสดงผล pinnedAt desc
  // (BR-PIN-09 no manual reorder); NULL = ไม่ปักหมุด. Auto-unpin (กลับเป็น NULL) ต้องเกิดในธุรกรรม
  // เดียวกับตอน isActive true→false เสมอ (BR-PIN-11 — service layer, product.service deleteProduct/updateProduct).
  // จำนวนปักหมุดต่อ shop <= Shop.pinSlots (enforce service layer เท่านั้น — ไม่มี DB constraint ข้ามแถว)
  pinnedAt          DateTime?

  // --- Expense & Cost Tracking (feature 00016, additive) ---
  // cost: ราคาทุนปัจจุบัน — nullable/opt-in (BR §3.1). ไม่บังคับกรอก, ไม่กระทบสินค้าเดิมที่ยังไม่ตั้ง
  // (zero-regression). Snapshot ลง OrderItem.cost ตอนสร้างออเดอร์ทุกครั้ง — แก้ค่านี้ทีหลังไม่มีผลย้อนหลัง
  // กับ OrderItem.cost ที่ snapshot ไปแล้ว (historical accuracy, D-5)
  // CHECK(cost IS NULL OR cost >= 0) enforce ด้วยมือใน migration SQL (NOT VALID + VALIDATE เพราะ
  // Product มี row จริงบน prod แล้ว — pattern เดียวกับ stockQty/lowStockThreshold feature 00003/00009)
  cost Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  tags            Tag[]
  stockMovements  StockMovement[] // Deep Stock Pro (feature 00009)
  chatMessageRefs ChatMessage[] // extension #1 Chat Product Context Card — back-relation ของ ChatMessage.productRefId

  // --- feature 00023 Chat Auto-Reply (additive) ---
  autoReplyRules           AutoReplyRule[] // เงื่อนไขสินค้าของกฎคำตอบ (nullable, onDelete SetNull ฝั่ง AutoReplyRule)
  conversationAutoReplyCtx Conversation[]  @relation("ConversationContextProduct") // back-relation ของ Conversation.contextProductId

  @@index([shopId, stockQty])
  @@index([shopId, pinnedAt]) // Pin Products (00013) — query "pinnedAt not null ORDER BY pinnedAt desc" ต่อ shop (FR-PIN-06)
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Order {
  id              String   @id @default(uuid())
  publicToken     String   @unique @default(uuid())
  shortCode       String?  @unique // permanent 8-char short alias สำหรับ copy/share link (nullable: backfill รุ่นเก่า)
  // orderNo (user 2026-07-25): เลขคำสั่งซื้ออ่านง่าย `DP` + ปีพ.ศ. + เดือน + publicToken 8 หลัก
  // deterministic (ไม่ใช่ running counter → ไม่มี race/reset/scale cost) — ดู src/lib/order-no.ts
  // index ธรรมดา (ไม่ unique): เป็นป้าย/ค้นหา ไม่ใช่ identity (publicToken ยังเป็น key จริง)
  orderNo         String?
  shopId          String
  buyerUserId     String?
  buyerContact    String?
  type            String   @default("PHYSICAL")
  totalAmount     Decimal  @db.Decimal(12, 2)
  status          String   @default("PENDING")
  fulfillmentMode String   @default("SHIPPED")
  cancelInitiator String?
  shippingAddress Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Phase B fields — additive, all nullable (migration order_fields_phase_b)
  paymentMethod String?
  salesChannel  String?
  internalNote  String?  @db.Text
  buyerName     String?
  // customerId: ผูก Customer กลาง (feat 00014) — server derive จาก buyerContact (เบอร์) ตอน createOrder;
  // buyerName/buyerContact ยังคง denormalized ไว้ (display per-order + backward compat)
  customerId    String?
  discount      Decimal? @db.Decimal(12, 2)
  vatRate       Decimal? @db.Decimal(5, 4)
  vatAmount     Decimal? @db.Decimal(12, 2)

  // Phase 2 fields — additive, nullable (migration order_slip_access_url)
  slipFileId String? // fileId ของสลิปโอนเงิน (storage); null = ยังไม่แนบ (Phase 2 OOS-1)
  accessUrl  String? // URL ส่งมอบ digital order; null = ยังไม่ส่งมอบ (Phase 2 OOS-2)

  // Buyer App — order ที่เกิดจากการชนะประมูล (additive, nullable, unique = 1 order ต่อ 1 auction)
  auctionId String? @unique

  // --- feature 00017: Lodging Vertical (Phase 2, additive nullable ทั้งหมด) ---
  // การจอง = Order ที่ type = "BOOKING" ไม่ใช่ตารางแยก (BR-LODG-08) จึงได้ publicToken/
  // shortCode/slipFileId/customerId/review/Trust Score/ประวัติออเดอร์ มาใช้ซ้ำทั้งหมด
  // field กลุ่มนี้เป็น NULL เสมอสำหรับออเดอร์สินค้าปกติ (zero-regression BR-LODG-27)
  roomId        String? // FK → Room, ON DELETE RESTRICT (ห้ามลบห้องที่มีการจอง BR-LODG-06)
  checkIn       DateTime? @db.Date // วันเข้าพัก — รวมในช่วงที่กันคิว
  checkOut      DateTime? @db.Date // วันเช็คเอาท์ — ไม่รวมในช่วงที่กันคิว (BR-LODG-31)
  // depositAmount: ยอดมัดจำที่ต้องโอน — snapshot ที่คำนวณเสร็จแล้ว ไม่ใช่สูตรอ้างอิง Room
  // ถ้าอ้างอิงสด ยอดของการจองเก่าจะขยับเองเมื่อเจ้าของแก้ค่าเริ่มต้นของห้อง = ผิด BR-LODG-18
  depositAmount Decimal?  @db.Decimal(12, 2)
  // cancelReason: BUYER_NO_TRANSFER | BUYER_REQUESTED | SHOP_ISSUE | MUTUAL (BR-LODG-36)
  // นับเข้าประวัติผู้จองเฉพาะ 2 ค่าแรก — ตัดสินจาก countsAgainstGuest ใน src/lib/lodging.ts
  cancelReason  String?

  // --- feature 00017 Lodging Vertical (Phase 3: แม่บ้าน, additive nullable) ---
  // housekeeperId: แม่บ้านที่รับผิดชอบทำความสะอาดรอบเข้าพักนี้ (BR-LODG-20) — NULL = ยังไม่มอบหมาย
  // ON DELETE SET NULL: ลบแม่บ้านออกจากรายชื่อได้ การจองเดิมยังอยู่ครบ แค่ไม่มีผู้รับผิดชอบผูก
  housekeeperId      String?
  // housekeepingStatus: PENDING | DONE — NULL = ยังไม่มอบหมาย (BR-LODG-26)
  // แยกจาก Order.status โดยสิ้นเชิง — งานแม่บ้านไม่กระทบสถานะการจองและ Trust Score
  housekeepingStatus String?

  // --- feature 00024: Service Appointment Booking (additive nullable ทั้งหมด) ---
  // การนัดหมาย = Order ที่ type = "SERVICE" ไม่ใช่ตารางแยก (BR-RSV-10) — รูปแบบเดียวกับ 00017
  // field กลุ่มนี้เป็น NULL เสมอสำหรับออเดอร์สินค้าปกติและการจองบ้านพัก (zero-regression BR-RSV-04)
  serviceResourceId String? // FK → ServiceResource, ON DELETE RESTRICT (BR-RSV-08)

  // serviceSeat: "ที่นั่งลำดับที่ n" ของทรัพยากรนั้น (1..capacity)
  // 🛑 หัวใจของการรองรับความจุ > 1 — เป็นกลไกภายในล้วน ๆ ไม่ใช่ข้อมูลที่ผู้ใช้เห็นหรือเลือกเอง
  //    service วนลอง seat 1,2,3... จนกว่า update จะผ่าน — ผ่านที่ไหน = ได้ที่นั่งนั้น
  //    ห้ามส่งค่านี้ออกไปใน API response ใด ๆ (ดู docs API.md §1)
  serviceSeat Int?

  // serviceStart/serviceEnd: ช่วงเวลาเข้าใช้บริการ — timestamptz เพราะบริการละเอียดระดับนาที
  // (ต่างจากบ้านพักที่ใช้ @db.Date ระดับวัน) นับแบบรวมเวลาเริ่ม ไม่รวมเวลาสิ้นสุด (BR-RSV-14)
  serviceStart DateTime? @db.Timestamptz(3)
  serviceEnd   DateTime? @db.Timestamptz(3)

  // appointmentStatus: SCHEDULED | CONFIRMED_BY_BUYER | RESCHEDULE_REQUESTED | COMPLETED | NO_SHOW
  // 🛑 แยกจาก Order.status โดยสิ้นเชิง (BR-RSV-33) — มิเรอร์ housekeepingStatus ของ feature 00017
  //    การเปลี่ยนค่านี้ต้องไม่แตะ Order.status และไม่กระทบ Trust Score (BR-RSV-35/36)
  appointmentStatus String?

  buyerConfirmedAt      DateTime? // ลูกค้ากดยืนยันนัดเมื่อไร (BR-RSV-26) — NULL = ยังไม่ยืนยัน
  rescheduleRequestNote String?   @db.Text // เหตุผลที่ลูกค้าขอเลื่อน (ไม่บังคับกรอก)

  shop             Shop                    @relation(fields: [shopId], references: [id])
  buyer            User?                   @relation("BuyerOrders", fields: [buyerUserId], references: [id])
  customer         Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  room             Room?                   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  housekeeper      Housekeeper?            @relation(fields: [housekeeperId], references: [id], onDelete: SetNull)
  serviceResource  ServiceResource?        @relation(fields: [serviceResourceId], references: [id], onDelete: Restrict) // feature 00024
  reschedules      AppointmentReschedule[] // feature 00024 — ประวัติการเลื่อนนัด (สะสม BR-RSV-30)
  items            OrderItem[]
  shipmentTracking ShipmentTracking?
  review           Review?
  smsCodes         SmsCode[]
  // NEW (feature 00022) — พัสดุที่เปิดกับขนส่งสำหรับออเดอร์นี้ (active ได้ใบเดียว บังคับด้วย partial
  // unique index `OrderShipment_active_order_key` — unmanaged SQL ดู DATABASE.md §4)
  shipments        OrderShipment[]

  // 🛑 EXCLUDE constraint `Order_room_no_overlap` มีอยู่จริงในฐานข้อมูล แต่ Prisma DSL
  // ประกาศไม่ได้ (unmanaged SQL — migration 20260722000100):
  //   EXCLUDE USING gist (roomId WITH =, daterange(checkIn, checkOut, '[)') WITH &&)
  //   WHERE (roomId IS NOT NULL AND status <> 'CANCELLED')
  // เป็นกลไก "เดียว" ที่กันจองทับได้จริงแม้กดพร้อมกัน — การตรวจก่อนบันทึกที่ระดับแอป
  // มีช่องว่างระหว่างตรวจกับเขียนเสมอ
  // 🛑 ห้าม `prisma db pull` / `migrate dev` เด็ดขาด — introspection มองไม่เห็น constraint นี้
  // แล้วจะสร้าง migration ที่ DROP ทิ้ง (precedent เดียวกับ partial unique index ของ feat 00008)
  // ทดสอบจริงแล้ว: Prisma โยน P2010 + meta.code '23P01' (ไม่ใช่ P2002) ดู DATABASE.md §4.2.1
  //
  // 🛑 EXCLUDE constraint `Order_service_seat_no_overlap` (feature 00024) ก็มีอยู่จริงเช่นกัน
  // แต่ Prisma DSL ประกาศไม่ได้ (unmanaged SQL — migration 20260731000100):
  //   EXCLUDE USING gist (serviceResourceId WITH =, serviceSeat WITH =,
  //                       tstzrange(serviceStart, serviceEnd, '[)') WITH &&)
  //   WHERE (serviceResourceId IS NOT NULL AND status <> 'CANCELLED')
  // ต่างจากของบ้านพักตรงมิติ `serviceSeat` ที่ทำให้ทรัพยากรหนึ่งหน่วยรับได้หลายคิวพร้อมกัน
  // ตามความจุที่ร้านตั้ง — เพดานความจุบังคับที่ service layer ด้วยการวนลอง seat 1..capacity
  // ข้อห้าม db pull / migrate dev ข้างบนครอบ constraint นี้ด้วย

  // index รองรับ /api/files order-slip gate: findFirst({ where: { slipFileId } }) (S-7)
  @@index([slipFileId])
  @@index([customerId]) // feat 00014 — lookup order ต่อ customer
  @@index([orderNo]) // user 2026-07-25 — ค้นหา/อ้างอิงด้วยเลขคำสั่งซื้อ (ไม่ unique — เป็นป้าย ไม่ใช่ identity)
  // NEW (feature 00016) — P&L Revenue query (FR-EXP-06-AC-01): WHERE shopId=X AND status='CONFIRMED'
  // AND createdAt BETWEEN start,end. ครอบคลุม dashboard.service.ts เดิมไปด้วย (query pattern เดียวกัน
  // แต่ไม่เคยมี index รองรับมาก่อน)
  @@index([shopId, status, createdAt])
  @@index([roomId, checkIn], map: "Order_roomId_checkIn_idx") // feat 00017 — ปฏิทินของห้อง
  @@index([shopId, type, checkIn], map: "Order_shopId_type_checkIn_idx") // ปฏิทินรวมทุกห้อง + list การจอง
  @@index([customerId, status], map: "Order_customerId_status_idx") // นับประวัติการยกเลิกต่อลูกค้า
  @@index([housekeeperId, housekeepingStatus], map: "Order_housekeeperId_status_idx") // feat 00017 P3 — หน้ารวมงานแม่บ้านที่ค้าง
  @@index([serviceResourceId, serviceStart], map: "Order_serviceResourceId_start_idx") // feat 00024 — ปฏิทินของทรัพยากร + หาที่ว่าง
  @@index([shopId, type, serviceStart], map: "Order_shopId_type_serviceStart_idx") // feat 00024 — ปฏิทินคิวรวมของร้าน
  @@index([shopId, appointmentStatus], map: "Order_shopId_appointmentStatus_idx") // feat 00024 — นัดที่รอร้านตัดสิน
}

// Customer (feat 00014 — Customer Directory) — ตัวตนลูกค้ากลาง keyed by phone (cross-shop identity).
// แยกจาก User: walk-in ไม่ต้องมี login; link User (userId) เมื่อลูกค้าสมัครเป็น buyer ทีหลัง (Phase 2).
// phone @unique global = "ห้ามเบอร์ซ้ำ" + เบอร์เดียว = customer เดียวข้ามร้าน.
// privacy: seller เห็นลูกค้าเฉพาะจาก order ของร้านตัวเอง (ชื่อเก็บที่ order.buyerName) — ไม่มีตาราง per-shop.
model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique // normalize 0xxxxxxxxx (src/lib/phone.ts) ก่อนเขียนเสมอ
  email     String? // optional เสริม — ไม่ unique (ไม่ใช่ตัวระบุหลัก)
  userId    String?  @unique // link → User (Phase 2); nullable ตอน MVP
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders           Order[]
  externalContacts ExternalContact[] // Facebook/Instagram chat integration (feature 00018) — link จาก PSID/IGSID เมื่อได้เบอร์
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String?
  name          String
  description   String?
  qty           Int
  price         Decimal @db.Decimal(12, 2)
  // stockDeducted: Inventory Add-on (feature 00003) — จำนวนที่ตัดสต็อกจริงตอนสร้าง order
  // (เท่ากับ qty เสมอ, all-or-nothing BR-INV-11); NULL = ไม่เคยตัด (untracked/entitlement ไม่ ACTIVE ตอนนั้น)
  // ใช้คืนสต็อกถูกต้องตอน cancel (BR-INV-12). CHECK(stockDeducted >= 0) ใน migration SQL
  stockDeducted Int?

  // --- Expense & Cost Tracking (feature 00016, additive) ---
  // cost: snapshot ต้นทุนสินค้า ณ วันขาย จาก Product.cost — เดียวกับ pattern ของ price (FR-EXP-02-AC-01)
  // NULL เมื่อ: (a) Product.cost เป็น null ณ ขณะสร้างออเดอร์ (FR-EXP-02-AC-02), หรือ (b) custom/manual
  // line item ที่ productId เป็น null (FR-EXP-02-AC-03) — ไม่ error, ไม่ default เป็น 0 ในทั้งสองกรณี
  // แก้ Product.cost ทีหลังไม่มีผลย้อนหลังกับค่านี้เด็ดขาด (FR-EXP-02-AC-04, historical accuracy)
  // CHECK(cost IS NULL OR cost >= 0) enforce ด้วยมือใน migration SQL (NOT VALID + VALIDATE เพราะ
  // OrderItem มี row จริงบน prod แล้ว — pattern เดียวกับ stockDeducted feature 00003)
  cost Decimal? @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // NEW (feature 00016) — orderId ไม่เคยมี index เลยตั้งแต่ init migration (Postgres ไม่ auto-index
  // scalar FK เหมือน MySQL) ทำให้ทุก query "OrderItem WHERE orderId IN (...)" เป็น sequential scan
  // มาตลอด. COGS calculation (FR-EXP-06-AC-02) ต้อง join OrderItem ของทุก order ที่เข้าเงื่อนไข Revenue
  // ในช่วงเวลาที่เลือก — เป็น query pattern ใหม่ที่ hot กว่าที่เคยมี จึงต้องเพิ่ม index นี้พร้อมฟีเจอร์นี้
  @@index([orderId])
}

model ShipmentTracking {
  id         String    @id @default(uuid())
  orderId    String    @unique
  provider   String
  trackingNo String
  status     String    @default("SHIPPED")
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id              String   @id @default(uuid())
  orderId         String   @unique
  reviewerUserId  String?
  reviewerContact String?
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewerReviews", fields: [reviewerUserId], references: [id])
}

model TrustScoreHistory {
  id           String   @id @default(uuid())
  userId       String
  score        Int
  breakdown    Json
  calculatedAt DateTime @default(now())
  // shopId: Business Reputation (feature 00008 Phase 5, P5-3) — nullable FK → Shop.
  // NULL = user-level history เดิม (backward-compat, zero-regression Personal shop);
  // non-NULL = trust score history ผูก Business shop โดยตรง (แยกจาก owner). ON DELETE CASCADE
  // (ลบ shop → history ของ shop นั้นไม่มีความหมายอีกต่อไป เหมือน UserBadge.shopId pattern)
  shopId       String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

// --- Wallet + SMS (Phase 4: Paid SMS Order Link + Seller Wallet/Credit) ---

model SellerWallet {
  id        String   @id @default(uuid())
  shopId    String   @unique
  // balance เป็น integer หน่วย ฿; RC-3: CHECK(balance >= 0) enforce ใน migration SQL ด้วยมือ
  balance   Int      @default(0)

  /// เศษค่า AI Enhance ที่ยังไม่ถึงเกณฑ์หัก — phase `00023-ai-enhance` (BR-AR-36)
  ///
  /// ทำไมต้องมี: `balance` เป็นจำนวนเต็มบาท และ `deductCredit()` โยน INVALID_AMOUNT ถ้า
  /// amount ไม่ใช่ integer บวก แต่ต้นทุนจริงต่อการตอบหนึ่งครั้งของ gemini-2.5-flash-lite
  /// อยู่ระดับเศษสตางค์ — ปัดขึ้นเป็น 1 บาททุกครั้งจะกลายเป็น "1 บาท/ครั้งคงที่" ซึ่ง user
  /// ปฏิเสธไปแล้ว (ต้องคิดตามที่ใช้จริง)
  ///
  /// กลไก (user เคาะ 2026-08-01): ทุกครั้งที่ AI ทำงานสำเร็จ บวกต้นทุนเข้าคอลัมน์นี้
  /// พอสะสมถึง >= 1.0000 จึงหักจำนวนเต็มออกจาก balance แล้วเหลือเศษสะสมต่อ
  /// ผลข้างเคียงที่ยอมรับ: ร้านเลิกใช้ก่อนสะสมครบ 1 บาท เศษค้างจะไม่ถูกหัก (ระดับสตางค์)
  ///
  /// Decimal(12,4) ไม่ใช่ Float — เป็นตัวเลขเงินที่ถูกบวกสะสมนับพันครั้ง ความคลาดเคลื่อน
  /// ของ floating point จะสะสมตามไปด้วย (หลักเดียวกับ AiSuggestUsageEvent.costUsd)
  pendingAiCostBaht Decimal @default(0) @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String   @id @default(uuid())
  walletId     String
  // type: "TOPUP" | "DEDUCT" — String ตาม convention project (ดู Order.status, VerificationRecord.status)
  type         String
  amount       Int
  balanceAfter Int
  description  String
  refId        String?
  // reason: machine-filterable label แยก DEDUCT source — ("SMS_ORDER_LINK" | "INVENTORY_SUBSCRIPTION"
  // [feature 00003] | "BUSINESS_PACKAGE_SUBSCRIPTION" [feature 00008, NEW — ไม่มี DDL แค่ค่าใหม่] |
  // "PIN_SLOT" [feature 00013, NEW — ซื้อ pin slot ฿99 ถาวร, ไม่มี DDL แค่ค่าใหม่] |
  // "AI_SUGGEST_EXTRA_USE" [feature 00019 ext 2026-07-29, NEW — หัก/คืน ฿1 credit path ของ ai-suggest
  // เกินโควตาฟรี BR-AIQ-01, ไม่มี DDL แค่ค่าใหม่]);
  // NULL = row เก่าก่อนฟีเจอร์ที่ใช้ field นี้ (backfill migration SQL)
  reason       String?
  createdAt    DateTime @default(now())

  wallet SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([reason])
}

// --- Inventory Add-on (feature 00003: paid sub ฿199/mo stock management) ---

enum InventoryEntitlementStatus {
  ACTIVE
  LOCKED
}

// InventoryEntitlement: สิทธิ์การใช้งาน Inventory Add-on ของ 1 Shop (1:1).
// NOT_SUBSCRIBED ไม่ใช่ enum value — คือ "ไม่มี row นี้เลย" (FROZEN CONTRACT — ดู DATABASE.md §3.1)
model InventoryEntitlement {
  id                 String                     @id @default(uuid())
  shopId             String                     @unique
  status             InventoryEntitlementStatus @default(ACTIVE)
  // package: Deep Stock Pro (feature 00009) — BASIC=฿199 (M00003 เดิม), PRO=฿599 (BASIC+Alert+Audit+CSV)
  package            InventoryPackage           @default(BASIC)
  activatedAt        DateTime
  currentPeriodStart DateTime
  nextRenewalAt      DateTime
  lastRenewalAt      DateTime?
  lockedAt           DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, nextRenewalAt])
  @@index([status, package]) // Deep Stock Pro — reporting/KPI (Pro MRR, Basic→Pro upgrade rate)
}

// --- Deep Stock Pro (feature 00009: 2-package inventory sub — BASIC ฿199 / PRO ฿599) ---

enum InventoryPackage {
  BASIC
  PRO
}

enum StockMovementSource {
  ORDER_DEDUCT
  ORDER_RESTOCK
  MANUAL_ADJUST
}

// StockMovement: audit log ทุก event ที่กระทบ Product.stockQty — record-always ทุก package (OD-C)
// ไม่ผูก FK ตรงกับ InventoryEntitlement โดยตั้งใจ — gate การมองเห็นที่ query-time ด้วยสถานะปัจจุบัน
// ของ entitlement ไม่ใช่ snapshot ตอนบันทึก (ดู DATABASE.md §3.2)
model StockMovement {
  id           String              @id @default(uuid())
  shopId       String
  productId    String?
  productName  String
  delta        Int
  resultingQty Int
  source       StockMovementSource
  refId        String?
  note         String?
  actorUserId  String?
  createdAt    DateTime            @default(now())

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  actor   User?    @relation("StockMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt]) // hot path: movement history ต่อสินค้า เรียงเวลาล่าสุดก่อน
  @@index([shopId, createdAt]) // cross-product movement list ต่อ shop
  @@index([shopId, source]) // filter ตาม source
}

// --- Business Account & Packages (feature 00008, Phase 1 additive) ---
// ดู docs/20 - Features/00008 - Business Account & Packages/DATABASE.md (FROZEN CONTRACT)
// Phase 1 เท่านั้น — ไม่แตะ Shop.userId @unique เดิม (Phase 2 constraint cutover = gated, แยก migration)

// ShopMember: membership User↔Shop (role: OWNER | ADMIN) — feature 00008
// แทนที่ FK ตรง Shop.userId 1:1 เดิม เป็น SSOT ใหม่ของ "สมาชิกร้านไหน บทบาทอะไร"
// ทุก Shop (PERSONAL/BUSINESS) มี ShopMember(role=OWNER) เสมอ 1 แถว
// invariant "1 OWNER ต่อ shop" enforce ที่ app layer เท่านั้น (ไม่มี DB constraint —
// ไม่มี ownership-transfer/co-ownership ใน MVP, PRD §5 out-of-scope, risk ต่ำ)
model ShopMember {
  id        String   @id @default(uuid())
  shopId    String
  userId    String
  // role: "OWNER" | "ADMIN" — String ตาม convention project (เทียบ Order.status/VerificationRecord.status)
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId]) // switcher query: shop ทั้งหมดที่ user คนนี้เป็นสมาชิก (FR-BIZ-14)
  @@index([shopId, role]) // list/count admin ต่อ shop (quota enforcement FR-BIZ-12) + lookup owner
}

enum BusinessPackageStatus {
  ACTIVE
  LOCKED_RENEWAL_FAILED
}

// BusinessPackageSubscription: สิทธิ์ subscription ระดับ Owner (1:1 User) — feature 00008
// ต่าง InventoryEntitlement (1:1 Shop) เพราะ 1 owner คุมโควตา Business หลายอัน (D-1)
// ไม่มี FREE เป็น status/value — "ไม่มี row นี้เลย" = FREE (มิเรอร์ NOT_SUBSCRIBED ของ InventoryEntitlement)
// ตั้งชื่อแยกจาก Shop.businessType เดิม (label นิติบุคคล L3 — คนละเรื่อง)
// cancel = DELETE row ทันที (grace timer อยู่ที่ Shop.packageLockedAt ต่อ shop ไม่ใช่ที่ row นี้)
model BusinessPackageSubscription {
  id                 String                @id @default(uuid())
  ownerId            String                @unique
  // tier: "GROWTH" | "PRO" | "BUSINESS" — String (ราคา/โควตาต่อ tier hardcode app-layer เหมือน
  // Inventory Add-on ฿199 — กัน ALTER TYPE ทุกครั้งที่ปรับราคา) ⚠️ ระวังสับสนกับ Shop.kind="BUSINESS"
  // (คนละแกนความหมาย ชื่อชนกันโดยตั้งใจตามชื่อ tier สูงสุดของธุรกิจ)
  tier               String
  status             BusinessPackageStatus @default(ACTIVE)
  activatedAt        DateTime // subscribe ครั้งแรกเท่านั้น ห้ามแตะตอน renew/upgrade/downgrade/reactivate (cohort marker)
  currentPeriodStart DateTime
  nextRenewalAt      DateTime
  lastRenewalAt      DateTime?
  lockedAt           DateTime? // reset NULL ทันทีที่ reactivate สำเร็จ
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, nextRenewalAt]) // renewal cron: status='ACTIVE' AND nextRenewalAt<=now() + advance-warning 3 วัน
}

// ShopInvite: คำเชิญ admin เข้า Business ผ่านเบอร์โทร/อีเมล — feature 00008
// ไม่มี @@unique([shopId, invitedContact]) โดยตั้งใจ — ไม่บล็อก invite ซ้ำหลัง CANCELLED
// (duplicate-pending check เป็น app-layer responsibility, ดู DATABASE.md §3.4)
model ShopInvite {
  id               String    @id @default(uuid())
  shopId           String
  // invitedContact: เบอร์โทร/อีเมล ดิบ — PII เทียบเท่า Order.buyerContact/Review.reviewerContact
  // ⚠️ ต้อง mask/neutralize ที่ RSC boundary ก่อนส่งลง client component (feedback_rsc_pii_neutralize_at_source)
  invitedContact   String
  // contactType: "PHONE" | "EMAIL" — จับคู่ User.phone/User.email ตอน accept (FR-BIZ-10)
  contactType      String
  // role: ปัจจุบันมีแค่ "ADMIN" — เก็บไว้ future-proof (Phase 2 RBAC granularity)
  role             String    @default("ADMIN")
  // status: "PENDING" | "ACCEPTED" | "CANCELLED" — String มิเรอร์ TopUpRequest.status
  status           String    @default("PENDING")
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop       Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("ShopInviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("ShopInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([shopId, status]) // list pending invite ของ shop (owner invite management page)
  @@index([invitedContact, status]) // เช็ค invite PENDING ค้างตอน user สมัคร/login (FR-BIZ-10-AC-02)
}

// ShopInviteLink: ลิงก์เชิญพนักงานแบบ reusable (`/i/<slug>`) — feature 00012
// ต่างจาก ShopInvite (contact-match, single-use ต่อคำเชิญ) ตรงที่เป็นลิงก์แชร์ซ้ำได้จนกว่าจะหมดอายุ/ถูก revoke
// ผู้ถูกเชิญ accept ผ่านลิงก์ (ไม่ผูก contact ล่วงหน้า) — กลายเป็น ShopMember(role=ADMIN)
model ShopInviteLink {
  id              String    @id @default(cuid())
  shopId          String
  slug            String    @unique
  // role: ปัจจุบันมีแค่ "ADMIN" — เก็บไว้ future-proof (มิเรอร์ ShopInvite.role)
  role            String    @default("ADMIN")
  createdByUserId String
  expiresAt       DateTime
  // revokedAt: NULL = ยังใช้งานได้ (ยัง valid ถ้า expiresAt ยังไม่ถึง); non-NULL = owner สั่งปิดใช้งานเอง
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy User @relation("ShopInviteLinkCreatedBy", fields: [createdByUserId], references: [id])

  @@index([shopId, revokedAt]) // list ลิงก์ที่ active ของ shop (owner management page /admins)
}

model TopUpRequest {
  id             String    @id @default(uuid())
  shopId         String
  amount         Int
  slipFileId     String
  // status: "PENDING" | "APPROVED" | "REJECTED"
  status         String    @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  rejectedReason String?
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shop       Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("TopUpReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([shopId])
  @@index([slipFileId])
  @@index([shopId, status, notifiedAt])
}

model SmsCode {
  id             String    @id @default(uuid())
  // codeHash: SHA-256 hex ของ raw code — เก็บแบบ hashed at rest (RC-3/D1)
  codeHash       String    @unique
  orderId        String
  buyerPhone     String
  expiresAt      DateTime
  usedAt         DateTime?
  // deliveryStatus: "PENDING" | "SENT" | "FAILED" — ใช้ reconcile crash (RC-3 AR-1)
  deliveryStatus String    @default("PENDING")
  createdAt      DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([codeHash])
  @@index([orderId])
  @@index([expiresAt])
}

// ============================================================
// Buyer App — Auction domain (additive; mobile-only)
// แยกจากระบบเดิมของ SafePay ทั้งหมด ไม่แก้ตารางเดิม. consume ผ่าน /api/app/*.
// เมื่อชนะประมูล (ปิดราคา) → ผูกเข้าระบบ Order/escrow/trust ของ SafePay
// ภายหลัง (Phase 2 — ดู memory project-scope). realtime (live) ยังไม่ทำ.
// ============================================================

model Auction {
  id             String    @id @default(uuid())
  shopId         String
  // productId: ลิงก์ไปสินค้าใน catalog เดิมได้ (optional — auction สร้าง item เองก็ได้)
  productId      String?
  title          String
  // description: คำอธิบายจาก create form (feature 00002 — Seller Auction)
  description    String?   @db.Text
  imageUrl       String
  // images: รูปเพิ่มเติม (JSON array of url) — รองรับ gallery/live feed
  images         Json      @default("[]")
  startPrice     Decimal   @db.Decimal(12, 2)
  currentPrice   Decimal   @db.Decimal(12, 2)
  bidIncrement   Decimal   @db.Decimal(12, 2)
  // startTime: เวลาเปิด (scheduled auction); null = live ทันทีตอนสร้าง (feature 00002)
  startTime      DateTime?
  endTime        DateTime
  // reservePrice: ราคาต่ำสุดที่ยอมขาย — bid สูงสุด < reserve → unsold (feature 00002, ห้ามส่งออก buyer)
  reservePrice   Decimal?  @db.Decimal(12, 2)
  // buyNowPrice: ซื้อทันที; null = ไม่มีตัวเลือกนี้ (feature 00002)
  buyNowPrice    Decimal?  @db.Decimal(12, 2)
  // status: "draft" | "scheduled" | "live" | "ended" | "unsold" | "cancelled" — ตรงกับ app type Auction.status
  status         String    @default("live")
  bidCount       Int       @default(0)
  // antiSnipeCount: จำนวนครั้งที่ต่อเวลาแล้ว (max 5) — feature 00002
  antiSnipeCount Int       @default(0)
  category       String?
  // cancelledAt: timestamp เมื่อ auction ถูกยกเลิก (feature 00002)
  cancelledAt    DateTime?
  // expectedPrice: ราคาเป้าหมาย seller-only indicator ล้วน ไม่กระทบ settle/sold/unsold — ห้ามส่งออกฝั่ง buyer (feature 00002, FR-AUC-13)
  expectedPrice  Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shop      Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bids      Bid[]
  watchList WatchList[]

  @@index([shopId])
  @@index([status, endTime])
  @@index([status])
  @@index([shopId, status])
  @@index([startTime])
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String
  bidderId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  auction   Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder    User          @relation("UserBids", fields: [bidderId], references: [id], onDelete: Cascade)
  reactions BidReaction[]

  @@index([auctionId, createdAt])
  @@index([bidderId])
}

// BidReaction — "ถูกใจ" ต่อ bid (feature 00005, reaction-only MVP)
// toggle: 1 user : 1 bid = 1 record (unique) — count จาก aggregate, ไม่ denormalize (bid feed ≤20 แถว)
model BidReaction {
  id        String   @id @default(uuid())
  bidId     String
  userId    String
  createdAt DateTime @default(now())

  bid  Bid  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  user User @relation("UserBidReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bidId, userId]) // กัน double-reaction (FR-REACT-02-AC-02)
  @@index([bidId])
  @@index([userId])
}

model WatchList {
  id        String   @id @default(uuid())
  userId    String
  auctionId String
  createdAt DateTime @default(now())

  user    User    @relation("UserWatches", fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId])
  @@index([userId])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  // Expo push token (ExponentPushToken[...]) — unique กัน register ซ้ำ
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  // kind: "outbid" | "won" | "system" | "badge_earned" — ตรงกับ app type Notification.kind
  kind      String
  title     String
  body      String
  // refId: id ของ auction/order ที่เกี่ยวข้อง (deep-link ฝั่งแอป)
  refId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// OtpCode — OTP signup/login/reset เก็บใน DB (shared ข้าม serverless instance)
// เดิมเก็บ in-memory (globalThis Map) → บน Vercel serverless send/verify วิ่งคนละ lambda
// → OTP ไม่เจอ → 401 ทั้งที่ถูก (bug prod 2026-06-16). 1 contact = 1 active OTP (upsert).
// codeHash = SHA-256 ของ OTP (hash at rest); single-use (ลบเมื่อ verify สำเร็จ/หมดอายุ/ครบ attempts)
model OtpCode {
  contact   String   @id // phone (0xxxxxxxxx) หรือ email
  codeHash  String // SHA-256 hex ของ OTP 6 หลัก
  expiresAt DateTime
  attempts  Int      @default(0) // กัน brute — ครบ 3 = ลบทิ้ง
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// --- Deep Chat (feature 00011, additive — ดู docs/20 - Features/00011 - Deep Chat/DATABASE.md) ---
// Conversation: 1 ห้องต่อคู่ (buyerUserId, shopId) — shop-anchored, buyer-initiate only (BR-CHAT-02/03)
// denorm lastMessage* บน Conversation กันหน้า inbox list ต้อง join ChatMessage ทุกครั้ง (BRD §6.1)

// ShopChannel — Page/IG ที่ร้านผูกไว้ (1 Shop : N channel) — feature 00018
model ShopChannel {
  id                String   @id @default(uuid())
  shopId            String
  provider          String // "MESSENGER" | "INSTAGRAM"
  externalId        String // Page ID หรือ IG Business Account ID
  name              String // ชื่อ Page ณ เวลาเชื่อม — cache ไว้แสดงใน UI ไม่ re-fetch ทุกครั้ง
  avatarUrl         String?
  // accessTokenEnc: page access token ที่ผ่าน AES-256-GCM แล้ว (src/lib/token-crypto.ts)
  // ห้ามเก็บ plaintext ห้าม log ห้ามส่งกลับ client ทุกกรณี
  accessTokenEnc    String
  connectedByUserId String
  status            String   @default("ACTIVE") // "ACTIVE" | "TOKEN_INVALID" | "DISCONNECTED"
  createdAt         DateTime @default(now())

  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  contacts       ExternalContact[]
  // back-relation ของ Conversation.shopChannel — Prisma บังคับต้องประกาศทั้งสองฝั่งของ relation
  conversations  Conversation[]
  // back-relation ของ AutoReplyRule.shopChannelId (feature 00023, additive) — เงื่อนไขเพจของกฎคำตอบ
  autoReplyRules AutoReplyRule[]

  // เดิม @@unique([provider, externalId]) = "1 เพจ 1 ร้านตลอดกาล" แม้ถอดแล้ว (status=DISCONNECTED)
  // ก็ยังกอด constraint ไว้ ทำให้ย้ายเพจไปร้านอื่นไม่ได้ (ชน P2002 ตลอดกาล) — แก้เป็น partial unique
  // index ที่สร้างด้วย SQL มือ (Prisma schema ประกาศ partial index ไม่ได้): unique เฉพาะแถวที่
  // status <> 'DISCONNECTED' ดู prisma/migrations/20260722000200_shopchannel_active_partial_unique/
  // — กติกาใหม่ "1 เพจ ACTIVE ได้ทีละร้านเดียว" (BR-FBC-01 เปลี่ยนขอบเขต ไม่ใช่ยกเลิก)
  @@index([provider, externalId])
  @@index([shopId, status])
}

// ExternalContact — ลูกค้าจากช่องทางนอก (PSID/IGSID) — ไม่ใช่ User ของ Deep — feature 00018
model ExternalContact {
  id             String   @id @default(uuid())
  shopChannelId  String
  externalUserId String // PSID / IGSID
  name           String?
  avatarUrl      String?
  customerId     String? // link → Customer (feature 00014) เมื่อได้เบอร์
  // --- CRM ต่อผู้ติดต่อ (feature 00018 tag/CRM) — ตามคนข้ามแชทของ contact นี้ ---
  // cross-channel merge (Messenger+IG+DEEP → โปรไฟล์เดียว) = Phase 2 (ต้อง resolve Customer ด้วยเบอร์)
  note           String? // โน้ตอิสระที่ต้องจดจำ — AI ใช้ประกอบการร่างคำตอบด้วย
  address        String?
  salesStatus    String   @default("UNSPECIFIED") // "UNSPECIFIED" | "INTERESTED" | "NOT_INTERESTED"
  tags           String[] @default([])
  phones         String[] @default([]) // เพิ่มได้หลายเบอร์ (CRM — คนละเรื่องกับ Customer.phone ที่ @unique)
  createdAt      DateTime @default(now())

  channel       ShopChannel    @relation(fields: [shopChannelId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@unique([shopChannelId, externalUserId]) // PSID เป็น page-scoped — ห้าม dedup ข้าม Page
}

model Conversation {
  id                 String    @id @default(uuid())
  buyerUserId        String?
  shopId             String
  // lastMessageAt/lastMessagePreview/lastSenderRole: denormalized snapshot ของข้อความล่าสุด
  // อัปเดตใน transaction เดียวกับ ChatMessage insert เสมอ (sendMessage — chat.service.ts) ห้ามอัปเดตแยก
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String? // snippet ข้อความล่าสุดสำหรับ inbox list (TEXT snippet หรือ "[รูปภาพ]" ถ้า type=IMAGE)
  lastSenderRole     String? // "BUYER" | "SHOP" — prefix "คุณ: " ที่ inbox เมื่อผู้ใช้ปัจจุบันคือฝั่งที่ส่งล่าสุด
  // buyerLastReadAt/shopLastReadAt: read-state ระดับ "ห้อง" (ไม่ใช่ต่อข้อความ — BR-CHAT-09)
  // NULL = ยังไม่เคยเปิดอ่านเลย; unread = lastMessageAt > (buyer|shop)LastReadAt ของฝั่งนั้น
  buyerLastReadAt    DateTime?
  shopLastReadAt     DateTime?
  createdAt          DateTime  @default(now())

  // --- feature 00018 Facebook/IG chat (additive) ---
  // channel: "DEEP" = แชทในแอป (ของเดิมทั้งหมด, default ทำให้ backfill ปลอดภัยเอง)
  //          "MESSENGER" | "INSTAGRAM" = เธรดจากช่องทางนอก (buyerUserId เป็น null)
  channel             String    @default("DEEP")
  shopChannelId       String?
  externalContactId   String?
  // lastInboundAt: เวลาที่ "ลูกค้า" ส่งข้อความล่าสุด — ฐานคำนวณ 24h messaging window ของ Meta
  // ต่างจาก lastMessageAt ที่ขยับเมื่อฝั่งไหนส่งก็ได้
  lastInboundAt       DateTime?
  // S-7 (ผลตัดสิน Q-4): ปักหมุด / ซ่อน / ปิดงาน ต่อเธรด — ใส่มาพร้อมกันในไฟล์ migration
  // เดียวเพราะ DB dev=prod แชร์กัน การ ALTER รอบสองมีต้นทุนความเสี่ยงมากกว่าการเพิ่มตอนนี้
  // ใช้กับเธรด DEEP ได้ด้วย ไม่ผูกกับช่องทางนอกอย่างเดียว
  isPinned            Boolean   @default(false)
  isHidden            Boolean   @default(false)
  resolvedAt          DateTime? // null = ยังเปิดอยู่
  // isSpam: เธรดสแปม (feature 00018, user สั่ง 2026-07-24) — คล้าย hide แต่ "ลูกค้าทักมาใหม่ไม่เด้งกลับ"
  // (ต่างจาก isHidden ที่ auto-unhide) และ webhook ไม่ส่ง Notification/beep; ยังรับ+เก็บข้อความปกติ
  // (Meta ส่ง webhook ระดับเพจ หยุดรายเธรดไม่ได้) — เปิดดูได้จากตัวกรอง "ดูสแปม"
  isSpam              Boolean   @default(false)
  // alias: ชื่อในแชท (nickname ต่อเธรดนี้) — เช่น "Wave 110" (ชื่อจริงอยู่ที่ contact/customer) feat 00018 CRM
  alias               String?
  // externalReadAt: watermark "ลูกค้าฝั่งช่องทางนอกอ่านถึงเวลานี้" (Messenger message_reads) — ข้อความ
  // ฝั่งร้าน (SHOP) ที่ createdAt <= ค่านี้ ถือว่า "อ่านแล้ว" (feature 00018 read receipt)
  externalReadAt      DateTime?
  // chatGroupId: กลุ่ม/แท็บที่ร้านจัดเธรดนี้ไว้ (feature 00018) — null = ยังไม่จัดกลุ่ม (แท็บ "ทั้งหมด")
  // ต่อ conversation (ไม่ใช่ต่อลูกค้า) เพื่อให้ใช้ได้ทุกช่องทางรวม DEEP; ลบกลุ่ม → SetNull (เธรดกลับ "ทั้งหมด")
  chatGroupId         String?
  // feature 00018 Phase 2 — ลูกค้าทักมาจากโฆษณา/ลิงก์ (messaging_referrals หรือ message.referral)
  //
  // E5 (2026-07-26): เปลี่ยนความหมายจาก "แรกเข้า" เป็น **ล่าสุด** — เดิมเซ็ตครั้งเดียวตอนสร้างเธรด
  // ลูกค้าเก่าที่กดโฆษณาตัวใหม่แล้วทักซ้ำจึงยังโชว์โฆษณาตัวแรกอยู่ ซึ่งผิดกับสิ่งที่ผู้ขายต้องรู้
  // (ลูกค้าคนนี้ "รอบนี้" มาจากโฆษณาไหน). ประวัติทั้งหมดยังอยู่ครบที่ ConversationAdReferral
  referralSource      String? // "ADS" | "SHORTLINK"
  referralAdTitle     String? // ads_context_data.ad_title = **ชื่อ ad ใน Ads Manager** ("video v3") ไม่ใช่ข้อความโฆษณา
  referralAdBody      String? // ข้อความโฆษณาจริงที่ลูกค้าเห็น (ดึงจากโพสต์ด้วย post_id) — ตัวที่แสดงบนแบนเนอร์
  referralAdPermalink String? // ลิงก์โพสต์โฆษณา — ปุ่ม "ดูโฆษณา" บนแบนเนอร์
  referralAdId        String? // referral.ad_id — คีย์ไปเทียบใน Ads Manager / Marketing API (Phase 2)
  referralPhotoFileId String? // รูปโฆษณาที่ mirror เข้า storage เราแล้ว (ไม่ hotlink CDN Meta ที่หมดอายุ)

  // --- feature 00023 Chat Auto-Reply (additive) ---
  // null = ตามค่าระดับร้าน (AutoReplyConfig.isEnabled); true/false = ร้านตั้งค่าเธรดนี้ไว้ชัดเจน
  // nullable ตั้งใจ: ต้องแยก "ยังไม่เคยตั้ง" ออกจาก "ตั้งเป็นปิด" ไม่งั้นปิดระดับร้านแล้วเปิดกลับ
  // จะปลุกเธรดที่ร้านตั้งใจปิดไว้ขึ้นมาด้วย (AC-015-03)
  autoReplyEnabled     Boolean?
  // หยุดชั่วคราวถึงเมื่อไหร่ (FR-016) — null = ไม่ถูกหยุด
  autoReplyPausedUntil DateTime?
  autoReplyCount       Int       @default(0) // นับคำตอบอัตโนมัติสะสม (AC-018-02)
  lastAutoReplyAt      DateTime?
  handoffAt            DateTime? // null = ยังไม่ถูกส่งต่อ
  handoffReason        String?
  // --- บริบทสินค้าของเธรด (FR-014) ---
  contextProductId     String?
  // "ADS_MAPPING" | "MANUAL" | "REFERRAL" — MANUAL ชนะเสมอ (BR-AR-12 / AC-014-02)
  contextProductSource String?
  contextProductAt     DateTime? // ใหม่กว่าชนะเมื่อที่มาระดับเดียวกัน (AC-014-03)

  buyer                User?                        @relation("BuyerConversations", fields: [buyerUserId], references: [id], onDelete: Cascade)
  shop                 Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages             ChatMessage[]
  shopChannel          ShopChannel?                 @relation(fields: [shopChannelId], references: [id], onDelete: Cascade)
  externalContact      ExternalContact?             @relation(fields: [externalContactId], references: [id], onDelete: Cascade)
  chatGroup            ChatGroup?                   @relation(fields: [chatGroupId], references: [id], onDelete: SetNull)
  adReferrals          ConversationAdReferral[]
  // feature 00023 Chat Auto-Reply (additive)
  autoReplyJobs        AutoReplyJob[]
  autoReplyLogs        AutoReplyLog[]
  autoReplyTestThreads AutoReplyKeywordTestThread[]
  contextProduct       Product?                     @relation("ConversationContextProduct", fields: [contextProductId], references: [id], onDelete: SetNull)

  @@unique([buyerUserId, shopId]) // BR-CHAT-02: 1 conversation ต่อคู่ (buyer, shop) เท่านั้น — กัน race ที่ getOrCreateConversation
  @@unique([shopChannelId, externalContactId]) // 1 เธรดต่อ (Page, PSID) — กัน race แบบเดียวกับ BR-CHAT-02
  @@index([shopId, lastMessageAt]) // seller inbox (/inbox): list ของร้าน เรียง lastMessageAt ล่าสุดก่อน (FR-CHAT-09-AC-01)
  @@index([buyerUserId, lastMessageAt]) // buyer inbox (/messages): list ของ buyer เรียง lastMessageAt ล่าสุดก่อน (FR-CHAT-07-AC-01)
  @@index([shopId, isHidden, isPinned, lastMessageAt]) // inbox list กรอง "ยังเปิดอยู่ + ไม่ซ่อน" แล้วเรียงหมุดขึ้นก่อน — ครอบ query หลักของหน้า /inbox
  @@index([chatGroupId]) // กรองแท็บกลุ่ม (feature 00018)
  // feature 00023 Chat Auto-Reply
  // 🛑 amend 2026-07-29 (GAP-06): sweeper fallback pass ต้องไล่หา "ข้อความลูกค้าล่าสุดที่ไม่มีงานผูก"
  // ซึ่งสแกนจาก lastInboundAt — SDS TD-008 ใช้ pass นี้เป็นเหตุผลว่า "enqueue พังเงียบยอมรับได้"
  // ถ้าไม่มี index เหตุผลนั้นไม่มีของจริงรองรับ. เพิ่มตอนนี้ฟรีเพราะยังไม่ migrate; เพิ่มทีหลัง
  // ต้อง ALTER ตารางใหญ่บน DB ที่ dev/prod แชร์กัน
  @@index([shopId, lastInboundAt])
  aiChatbotTestThreads AiChatbotTestThread[] // แชทที่ถูกเลือกไว้ทดสอบ ChatBot

}

// ChatGroup — กลุ่ม/แท็บจัดหมวดแชทที่ร้านตั้งเอง (feature 00018, user request 2026-07-23)
// เช่น "ทั่วไป", "ร้านอะไหล่", "ไม่สนใจ" — seller กด "+" เพิ่มเองในหน้า inbox, คลิกขวาเธรดเพื่อย้ายเข้ากลุ่ม
// ConversationAdReferral — ประวัติ "ที่มาจากโฆษณา" ของเธรด (feature 00018 E5, 2026-07-26)
//
// 1 แถวต่อการคลิกโฆษณา 1 ครั้ง ไม่ทับของเดิม เพราะ Meta ส่ง referral มาทาง webhook รอบเดียวและ
// **ไม่มี Graph API ให้อ่านย้อนหลัง** (Conversation node มีแค่ id/is_owner/messages/participants/
// updated_time) — ถ้าเก็บแค่ค่าล่าสุดแบบทับทิ้ง ข้อมูลหายถาวร เอาคืนไม่ได้
//
// ค่าล่าสุดยัง denormalize ไว้ที่ Conversation.referral* ด้วย (แบนเนอร์อ่านจากตรงนั้น ไม่ต้อง join
// และเธรดเก่าที่มีข้อมูลอยู่ก่อน E5 ยังแสดงได้) — ตารางนี้คือข้อมูลดิบสำหรับรายงาน Phase 2
model ConversationAdReferral {
  id             String   @id @default(uuid())
  conversationId String
  source         String? // "ADS" | "SHORTLINK" — แบนเนอร์แสดงเฉพาะ ADS
  adId           String?
  adTitle        String? // ชื่อ ad ใน Ads Manager (ไม่ใช่ข้อความโฆษณา)
  adBody         String? // ข้อความโฆษณาจริง — ดึงจากโพสต์ {pageId}_{postId} ตอนรับ webhook
  adPermalink    String? // ลิงก์โพสต์โฆษณา (permalink_url)
  photoFileId    String? // รูปโฆษณาที่ mirror เข้า storage แล้ว
  photoUrl       String? // URL ต้นทางจาก Meta — เก็บไว้ debug/mirror ซ้ำ (หมดอายุได้)
  videoUrl       String?
  postId         String?
  productId      String?
  flowId         String?
  refPayload     String? // referral.ref — ข้อความที่ร้านฝังไว้เองในโฆษณา
  receivedAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, receivedAt]) // "referral ล่าสุด/ทั้งหมดของเธรดนี้"
}

model ChatGroup {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  sortOrder Int      @default(0) // ลำดับแท็บ (ตามลำดับที่สร้าง)
  createdAt DateTime @default(now())

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([shopId, name]) // ชื่อกลุ่มห้ามซ้ำในร้านเดียวกัน
  @@index([shopId, sortOrder])
}

// ChatMessage: ข้อความ 1 รายการ — TEXT หรือ IMAGE (1 รูป/ข้อความ, BR-CHAT-05) — append-only (ไม่มี updatedAt/edit/delete ใน MVP)
model ChatMessage {
  id               String   @id @default(uuid())
  conversationId   String
  senderUserId     String?
  // senderRole: derive จาก conversation ตอนส่งเสมอ — snapshot กัน role drift ถ้าอนาคต user เปลี่ยนบทบาท (FR-CHAT-04-AC-03)
  senderRole       String // "BUYER" | "SHOP"
  // type/body/imageUrl: String ไม่ใช่ enum (เดินตาม convention เดิมของ Order.status/Product.type — ค่า user-facing ที่ validate ที่ Valibot)
  type             String   @default("TEXT") // "TEXT" | "IMAGE" | "PRODUCT"
  body             String? // TEXT: เนื้อหาข้อความ (cap ความยาวที่ app layer, BR-CHAT-06); IMAGE: caption (optional)
  imageUrl         String? // เฉพาะ type=IMAGE — reuse lib/storage upload route เดิม
  // productRefId: extension #1 Chat Product Context Card (FR-CTX-05) — เฉพาะ type=PRODUCT
  // nullable FK, onDelete SetNull — สินค้าถูกลบไม่ลบข้อความในเธรด (BR-CTX-04 ไม่ snapshot, live-join)
  productRefId     String?
  // orderRefToken: การ์ดออเดอร์/ใบเสนอราคาในแชท (user request 2026-07-24) — เฉพาะ type=ORDER (แชท DEEP)
  // เก็บ Order.publicToken (live-join enrich ตอน GET เหมือน PRODUCT) ไม่ FK — order ลบไม่ลบข้อความ
  // ช่องทางนอก (Messenger/IG) ไม่ใช้ type=ORDER — ส่งเป็นลิงก์ TEXT แทน (Meta ไม่ render การ์ดในแอปเรา)
  orderRefToken    String?
  createdAt        DateTime @default(now())
  // flaggedScam/scamMatchedRules: extension #3 Scam-link Detection — heuristic scam-link flag ณ เวลาส่ง (snapshot, ไม่ re-scan ย้อนหลัง BR-SCAM-05)
  flaggedScam      Boolean  @default(false)
  scamMatchedRules Json? // rule IDs ที่ match (audit) — เช่น ["R-SHORTENER","R-KEYWORD"]
  // feature 00018 Phase 2 — reaction บนข้อความนี้ (message_reactions webhook): emoji ล่าสุดจากลูกค้า/ร้าน
  // null = ไม่มี/ถูก unreact. เก็บ emoji ตรง ๆ (ไม่ normalize) แสดงมุมล่างบับเบิลในเธรด
  reactionEmoji    String?
  // feature 00018 Phase 3 — reply/unsend
  replyToMid       String? // externalMessageId ของข้อความที่ "ตอบทับ" (message.reply_to.mid) — แสดง quote
  isDeleted        Boolean  @default(false) // ผู้ส่ง unsend ข้อความ (message.is_deleted) — แสดง "ข้อความถูกลบ"

  // --- feature 00018 (additive) ---
  // externalMessageId: mid จาก Meta — unique เพื่อ idempotency
  // Meta redeliver webhook ซ้ำได้ตลอด และ echo ของข้อความที่เราส่งเองก็กลับมาด้วย mid เดิม
  // unique constraint จึงทำหน้าที่ dedupe ให้ทั้งสองกรณีโดยไม่ต้องเขียน logic แยก
  externalMessageId String? @unique
  deliveryStatus    String? // null = แชทในแอป (ไม่เกี่ยว) | "SENT" | "FAILED"
  failureReason     String?

  // --- feature 00023 (additive) ---
  // null = คนส่ง | "AUTO" = ระบบตอบ | "AUTO_TEST" = ระบบตอบขณะอยู่ในโหมดทดสอบ
  // 🛑 คอลัมน์นี้คือสิ่งที่ทำให้ BR-AR-22 บังคับได้: "พนักงานตอบ" = senderRole='SHOP' AND autoReplyKind IS NULL
  // ถ้าไม่มีคอลัมน์นี้ คำตอบของระบบเองจะถูกนับเป็น "พนักงานตอบ" แล้วระบบจะหยุดตัวเองทุกครั้งที่ตอบ
  autoReplyKind String?

  // seq — ลำดับที่แถวถูกบันทึกจริง ใช้เป็นตัวตัดสินเมื่อ createdAt เท่ากัน (feature 00018)
  // ทำไมต้องมี: Meta ส่งเวลาของข้อความระบบ/การ์ดมาแค่ระดับ "วินาที" (13:41:43.000) ขณะที่
  // ข้อความปกติจาก webhook มีระดับมิลลิวินาที — ข้อความที่เกิดวินาทีเดียวกันจึงเสมอกัน แล้ว
  // การเรียงด้วย createdAt อย่างเดียวได้ลำดับไม่แน่นอน (ขึ้นกับว่า Postgres คืนแถวไหนก่อน)
  // พิสูจน์แล้วกับเธรดจริง: ลำดับของเราสลับกับที่ Graph API คืนมา (user report 2026-07-31)
  // เป็น SERIAL ไม่ใช่ BIGSERIAL ตั้งใจ — BigInt ของ Prisma กลายเป็น JS BigInt ที่ JSON.stringify
  // โยน error ทันทีเมื่อถูกส่งออกทาง API; Int รองรับ 2.1 พันล้านแถว เกินพอ
  seq           Int      @unique @default(autoincrement())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?         @relation("SentChatMessages", fields: [senderUserId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productRefId], references: [id], onDelete: SetNull)
  // feature 00023 Chat Auto-Reply — back-relation ของ AutoReplyJob.chatMessageId (@unique — 1:1)
  autoReplyJob AutoReplyJob?

  @@index([conversationId, createdAt]) // thread pagination cursor-based เรียงเก่า→ใหม่ (FR-CHAT-08-AC-01/FR-CHAT-10-AC-01)
  @@index([conversationId, autoReplyKind, createdAt]) // หา "ข้อความคนล่าสุด" ของเธรด (feature 00023)
}

// QuickMessage — ข้อความสำเร็จรูป (canned reply) ระดับร้าน (feature 00018 composer improvement #2)
// ผูก shopId: ทุกคนในร้าน (owner + ShopMember) เห็น/ใช้/แก้ชุดเดียวกัน (ผลตัดสินผู้ใช้ 2026-07-23)
// รองรับ "message + image": body เป็นข้อความ, imageFileId เป็นรูปแนบ (storage fileId) — อย่างน้อย
// ต้องมี body หรือ imageFileId (บังคับที่ app layer/Valibot ไม่ใช่ DB constraint)
model QuickMessage {
  id              String   @id @default(uuid())
  shopId          String
  title           String // หัวข้อสั้น ๆ ใช้แสดงบน pill/list (เช่น "ทักทาย", "แจ้งเลขพัสดุ")
  category        String? // หมวด (optional) — จัดกลุ่มใน modal จัดการ
  body            String // เนื้อหาข้อความ (ว่างได้ถ้ามีแต่รูป)
  imageFileId     String? // deprecated (2026-07-23) — รูปแรกของ imageFileIds, คงไว้ให้ payload/โค้ดเก่าอ่านได้
  // รูปแนบหลายรูป (storage fileId) — user สั่ง 2026-07-23 "ใส่รูปได้มากกว่า 1"; จำกัด 5 รูปที่ Valibot
  // TEXT[] คอลัมน์เดียว (ไม่ทำ table แยก) — ลำดับในอาร์เรย์ = ลำดับที่ส่ง และไม่มี query ที่ต้อง
  // join/aggregate รายรูป (แบบเดียวกับ ExternalContact.tags/phones)
  imageFileIds    String[] @default([])
  createdByUserId String // audit เบา — ใครสร้าง (ไม่ใช่ ownership; ownership = shopId)
  // sortOrder: ลำดับที่ร้านลากจัดเอง (user request 2026-07-30) — น้อย = อยู่ก่อน
  // ตัวเลขห่างกันได้ ไม่ต้องต่อเนื่อง (reorder เขียนใหม่ทั้งชุดอยู่แล้ว)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, category, createdAt]) // list ต่อร้าน จัดกลุ่มตามหมวด เรียงใหม่ก่อน
  @@index([shopId, sortOrder]) // list ต่อร้านตามลำดับที่ร้านจัดเอง (ลำดับหลักของแผงข้อความสำเร็จรูป)
}

// --- Expense & Cost Tracking (feature 00016, additive) ---
// ดู docs/20 - Features/00016 - Expense & Cost Tracking/DATABASE.md (FROZEN CONTRACT)
// Expense: ค่าใช้จ่ายดำเนินธุรกิจที่ seller บันทึกเอง แยกหมวดตาม fixed list — feature 00016
// Period-level เท่านั้น (ไม่ allocate ลงรายออเดอร์, D-10/§4.4 ของ PRD) — ผูก shopId ตรง
// ไม่มี state machine (แก้/ลบได้ทุกเวลา, BR §3.3) ไม่มี audit trail ละเอียด (createdByUserId = audit เบา)
model Expense {
  id              String   @id @default(uuid())
  shopId          String
  // category: fixed list 7 ค่า — "RENT" | "PACKAGING" | "ADVERTISING" | "SHIPPING" | "SALARY" |
  // "UTILITIES" | "OTHER". String ตาม convention project (ไม่ใช้ Prisma enum จริง — เลี่ยง ALTER TYPE
  // ทุกครั้งที่ปรับหมวดในอนาคต, PRD §3.4 เหตุผล) ไม่มี DB CHECK ของค่า — validate ที่ Valibot เท่านั้น
  // (มิเรอร์ Shop.kind/ShopMember.role/Order.status/TopUpRequest.status ที่ไม่มี CHECK เช่นกัน)
  category        String
  // amount: > 0 เสมอ (BR §3.3, FR-EXP-03-AC-02) — DB CHECK ตรง (table ใหม่ ไม่มี row เก่า)
  amount          Decimal  @db.Decimal(12, 2)
  // expenseDate: วันเกิดค่าใช้จ่าย — แยกจาก createdAt รองรับ backdate (D-11). ไม่มี DB default;
  // ถ้าไม่ระบุ service layer default เป็นวันนี้ (timezone ไทย) ก่อนเขียนลง DB (FR-EXP-03-AC-04)
  expenseDate     DateTime
  note            String?  @db.Text
  // createdByUserId: ผู้บันทึก (owner หรือ admin ที่ staffCanViewFinance=true) — audit เบา, ไม่มี
  // versioning/diff history (Out of Scope PRD §5) — onDelete ไม่ระบุ = Restrict (มิเรอร์ ShopInviteLink)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy User @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])

  // P&L query หลัก (FR-EXP-08-AC-01): WHERE shopId=X AND expenseDate BETWEEN start,end
  // ครอบคลุมทั้ง list view ของหน้า /expenses (เรียง expenseDate) และ Total Expense sum
  @@index([shopId, expenseDate])
}

// ── feature 00019 AI Reply Assistant ────────────────────────────────────────
// ตั้งค่าผู้ช่วยร่างคำตอบ AI ต่อร้าน (SSOT: docs/20 - Features/00019 - AI Reply Assistant/DATABASE.md)
// ทำไมแยกตารางแทนเพิ่มคอลัมน์ใน Shop (SDS TD-001): Shop ถูกอ่านแทบทุก request (session/layout/proxy)
// การพก instruction ขนาดถึง 2KB ไปกับทุก query ที่ไม่ได้ใช้เป็นการเปลืองเปล่า ๆ —
// ตารางนี้ถูกอ่านเฉพาะตอนขอร่างคำตอบและตอนเปิดหน้าตั้งค่าเท่านั้น
model ShopAiSetting {
  id                     String   @id @default(uuid())
  // shopId @unique = บังคับความสัมพันธ์ 1:1 ที่ระดับ DB ไม่พึ่งวินัยของโค้ด และเป็น index ของ query หลักไปในตัว
  shopId                 String   @unique
  // instruction: คำสั่งประจำร้านที่เจ้าของร้านเขียนเอง — เพดาน 2,000 ตัวอักษรบังคับที่ Valibot
  // (ไม่ใช่ที่ DB) แล้วตัดซ้ำอีกครั้งตอนประกอบ prompt กันข้อมูลเก่าที่ยาวเกิน (defense-in-depth)
  instruction            String?
  includeProductContext  Boolean  @default(true)
  includeCustomerContext Boolean  @default(true)
  // includeMediaContext: ส่ง "รูป/ข้อความเสียง" ในแชทเข้า AI ด้วย (feature 00019 ext, user 2026-07-24)
  // เพื่อให้ AI อ่านรูป (สลิป/ป้ายที่อยู่/รูปสินค้า) และถอดเสียงมาใช้ร่างคำตอบได้
  // ⚠ เปิด = ไฟล์จากลูกค้าถูกส่งเข้า Gemini ทั้งไฟล์ ซึ่งอาจมี PII (เบอร์/ที่อยู่ในรูป) — ต่างจาก
  // บริบทข้อความที่เรากรอง PII ออกก่อน จึงแยกเป็นสวิตช์ให้ร้านปิดได้ (default เปิดตามที่ user เลือก)
  includeMediaContext    Boolean  @default(true)
  // updatedByUserId: SetNull — ลบผู้ใช้ต้องไม่ลบการตั้งค่าของร้านทิ้ง
  updatedByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// --- AI Suggestion Usage Limit + Credit (feature 00019 ext, 2026-07-29) ---
// SSOT: docs/20 - Features/00019 - AI Reply Assistant/EXTENSIONS-2026-07-29-usage-limit.md
// ครอบเฉพาะ POST /api/chat/conversations/{id}/ai-suggest เท่านั้น (BR-AIQ-10) — ไม่ใช่โควตาของฟีเจอร์ AI อื่น

// AiSuggestDailyUsage: ตัวนับโควตาฟรีต่อร้านต่อวัน (ปฏิทินไทย Asia/Bangkok, เที่ยงคืนรีเซ็ต)
// ⚠️ ใช้เฉพาะร้านที่ "ไม่ใช่" paid plan — ร้าน paid plan (unlimited path) ไม่มีแถวถูกอ่าน/เขียนจากตารางนี้
// เลยสักครั้ง (BR-AIQ-02, FR-AIQ-01/02)
// date เป็น String "YYYY-MM-DD" จาก todayThaiIsoDate() (src/lib/date-range.ts, มีอยู่แล้ว) ไม่ใช่ DateTime —
// ตั้งใจให้ query exact-match ตรงไปตรงมา ไม่ต้อง timezone-shift ซ้ำตอน query (BR-AIQ-05) และให้
// @@unique([shopId, date]) เป็น WHERE ของ atomic conditional updateMany เดียว (claim free slot ตอนนับเพิ่ม,
// คืนโควตาตอน refund) กัน concurrent request 2 ตัวแย่ง free slot สุดท้ายพร้อมกัน (FR-AIQ-07/E5,
// NFR-AIQ-Concurrency — pattern เดียวกับ deductCredit ใน wallet.service.ts)
// lazy-create: แถวถูกสร้างตอน "claim" จริงเท่านั้นผ่าน upsert — GET /api/chat/ai-quota (pre-check) อ่าน
// อย่างเดียว ไม่สร้างแถว (FR-AIQ-05/E8) กันตารางบวมจากร้านที่แค่เปิดแผง AI ดูเฉย ๆ ไม่เคยกดขอร่างจริง
model AiSuggestDailyUsage {
  id        String   @id @default(uuid())
  shopId    String
  date      String // "YYYY-MM-DD" เวลาไทย (BR-AIQ-05)
  count     Int      @default(0) // จำนวนครั้งที่ใช้ "โควตาฟรี" ไปแล้วของวันนี้ — cap ที่ 10 ในโค้ด (BR-AIQ-03/06), ห้ามติดลบ (CHECK ใน migration SQL — บั๊ก refund ซ้ำต้องชนที่ DB ไม่ใช่แค่ log)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // unique ทำหน้าที่ 2 อย่างพร้อมกัน: บังคับ "1 แถวต่อร้านต่อวัน" ที่ระดับ DB + เป็น index ของ WHERE
  // เดียวที่ทุก query ใช้ (shopId+date คู่กันเสมอ) — ไม่มี query อื่นที่ filter shopId เดี่ยว ๆ บนตารางนี้
  // จึงไม่ต้องมี index แยกเพิ่ม
  @@unique([shopId, date])
}

// AiSuggestUsageEvent: audit log ทุกครั้งที่ ai-suggest ผ่าน gate นี้ "สำเร็จ" (ทั้ง 3 path — FREE/CREDIT/
// UNLIMITED_PLAN) เก็บไว้เพื่อ debug + สนับสนุน admin cost dashboard ในอนาคต (Deferred เฟสนี้, NFR-AIQ-Obs)
// 🛑 ไม่ผูก logic gate ใด ๆ ของ feature นี้เลย — เขียนแบบ best-effort หลัง gate ตัดสินใจแล้วเท่านั้น
// (ถ้า insert แถว event ล้มเหลว ต้องไม่ทำให้ request หลักที่ผู้ใช้รอ suggestions อยู่พังตาม)
model AiSuggestUsageEvent {
  id             String   @id @default(uuid())
  shopId         String
  // conversationId: เก็บไว้เพื่อ trace เท่านั้น — ตั้งใจไม่ใส่ FK/relation ไปยัง Conversation (มิเรอร์
  // WalletTransaction.refId) เพื่อให้ audit log คงอยู่อิสระจากวงจรชีวิตของเธรดแชท (ลบ/archive
  // conversation ในอนาคตไม่ต้องแตะ/ลบ audit log นี้ตาม)
  conversationId String
  // kind: "FREE" | "CREDIT" | "UNLIMITED_PLAN" — String ตาม convention project (เทียบ WalletTransaction.type)
  // FREE = free path (non-paid, ในโควตา 10), CREDIT = credit path (non-paid, หักเครดิต ฿1),
  // UNLIMITED_PLAN = unlimited path (paid plan, bypass ทั้งหมด — BR-AIQ-02)
  kind           String
  amountBaht     Int      @default(0) // 0 = FREE/UNLIMITED_PLAN, 1 = CREDIT (BR-AIQ-01)
  // status: "SUCCESS" | "REFUNDED" — เปลี่ยนจาก SUCCESS เป็น REFUNDED เมื่อสิทธิ์ที่ใช้ไปถูกคืน (BR-AIQ-07)
  // มีผลเฉพาะ kind FREE/CREDIT เท่านั้น — unlimited path ไม่มีอะไรให้คืน จึงไม่มีทาง REFUNDED (BR-AIQ-07/E4)
  status         String   @default("SUCCESS")
  // businessDay: denormalize "YYYY-MM-DD" เวลาไทยของ createdAt จาก todayThaiIsoDate() ตัวเดียวกับ
  // AiSuggestDailyUsage.date (ไม่ใช่ FK/ผูก logic ใด ๆ — แค่สำเนาไว้กันคำนวณ timezone ซ้ำตอน query
  // รายงาน) เพื่อ group by วันปฏิทินไทยแบบ exact-match ได้ตรงกับตัวนับโควตา สำหรับ admin cost
  // dashboard ในอนาคต (Deferred, NFR-AIQ-Obs) — ต่างจาก createdAt (timestamp เต็ม, ใช้ sort/range)
  businessDay    String

  // --- ต้นทุนจริงต่อครั้ง (user 2026-07-31: "จะได้คิดราคาขายได้") ---
  //
  // อ่านจาก usageMetadata ของ Gemini ไม่ใช่ประมาณจากความยาวข้อความ — โมเดล 3.x เป็น thinking
  // model ที่เผา token "คิด" ก่อนตอบ ซึ่งนับรวมใน outputTokens และมองไม่เห็นจากคำตอบที่ได้
  // นี่คือเหตุผลที่ต้นทุนจริงสูงกว่าที่เดาจากตัวอักษรมาก
  //
  // nullable ทั้งหมด: แถวเก่าก่อนฟีเจอร์นี้ไม่มีค่า และ Gemini อาจไม่ส่ง usageMetadata มา
  // ซึ่งต้องไม่ทำให้บันทึกการใช้งานหายไปทั้งแถว
  aiModel      String? // รุ่นที่ตอบจริง — อาจไม่ใช่ตัวแรกใน MODEL_CANDIDATES ถ้าถอยไปตัวสำรอง
  inputTokens  Int?
  outputTokens Int? // รวม thinking token
  // Decimal ไม่ใช่ Float: ค่าอยู่ระดับเศษสตางค์ ($0.0042) และจะถูกเอาไป sum เพื่อตั้งราคาขาย
  costUsd      Decimal? @db.Decimal(12, 8)

  createdAt      DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt]) // audit trail ต่อร้าน เรียงเวลาล่าสุดก่อน (debug/support)
  @@index([shopId, businessDay]) // รายงานต้นทุนรายวันต่อร้าน แบบ group by ปฏิทินไทย (admin cost dashboard, Deferred)
}

// ============================================================================
// feature 00022 — iShip Shipping Integration
// ร้านผูกบัญชีขนส่ง iShip ด้วย token ที่วางเอง แล้วเปิดพัสดุจากคำสั่งซื้อ +
// พิมพ์ใบปะหน้า A6 ได้จากหน้าเรา — ดู docs/20 - Features/00022 .../DATABASE.md
//
// 🛑 ใช้ได้เฉพาะร้าน Shop.vertical = "GENERAL" — ร้าน "LODGING" (บ้านพัก) ไม่มีฟีเจอร์นี้
//    (BR-ISHIP-01/02) บังคับที่ service layer — DB ไม่มี cross-table CHECK
// 🛑 ไม่แตะตาราง Order/Shop แม้แต่คอลัมน์เดียว — ได้แค่ back-relation (ไม่สร้างคอลัมน์จริง)
// ============================================================================

// ShopShippingAccount — การเชื่อมต่อ iShip ของร้าน + ค่าตั้งต้นทั้งหมดในตารางเดียว
// ไม่แยกตาราง settings เพราะค่าเหล่านี้ไม่มีความหมายถ้าไม่มีการเชื่อมต่อ และเป็น 1:1 กับ Shop อยู่แล้ว
model ShopShippingAccount {
  id             String  @id @default(uuid())
  // shopId @unique = 1 ร้าน 1 บัญชีขนส่ง (BR-ISHIP-10) บังคับที่ DB ไม่พึ่งวินัยของโค้ด
  shopId         String  @unique
  provider       String  @default("ISHIP") // เผื่อผู้ให้บริการรายอื่นในอนาคต ไม่ต้อง migrate ซ้ำ
  // accessTokenEnc: token ที่ร้านวางเอง ผ่าน AES-256-GCM แล้ว (src/lib/token-crypto.ts ตัวเดียวกับ
  // ShopChannel ของ feature 00018) 🛑 ห้ามเก็บ plaintext ห้าม log ห้ามส่งกลับ client ทุกกรณี
  accessTokenEnc String
  tokenLast4     String? // 4 ตัวท้ายไว้ให้ร้านยืนยันว่าใช่ใบที่ตั้งใจ (BR-ISHIP-13)
  status         String  @default("ACTIVE") // "ACTIVE" | "TOKEN_INVALID" | "DISCONNECTED"
  // createMode: พฤติกรรมเมื่อสร้างคำสั่งซื้อ — "AUTO" | "ASK" | "OFF"
  // 🛑 default OFF (BR-ISHIP-20): การเปิดพัสดุ = ค่าใช้จ่ายจริง ระบบต้องไม่ทำแทนโดยร้านไม่ได้สั่ง
  //    เดิมเป็น ASK แต่ร้านที่ยังไม่ได้ตั้งค่าอะไรเลยโดนถามทุกครั้งที่สร้างคำสั่งซื้อ —
  //    คำถามที่ตอบ "ไม่" ทุกครั้งคือคำถามที่ไม่ควรถาม ร้านเปิด ASK/AUTO เองได้ที่หน้าตั้งค่า
  createMode     String  @default("OFF")

  // --- ที่อยู่ผู้ส่ง (บังคับครบก่อนเปิดใช้งาน BR-ISHIP-30 — nullable ใน DB เพราะกรอกทีหลังได้) ---
  senderName        String?
  senderPhone       String?
  senderAddress     String?
  // 🛑 BR-ISHIP-31 — ชื่อฟิลด์กลับหัวกับ iShip ห้ามจับคู่ตามชื่อ:
  //    senderSubdistrict (ตำบล/แขวง) → ส่งไปช่อง `src_district` ของ iShip
  //    senderDistrict    (อำเภอ/เขต) → ส่งไปช่อง `src_amphure`  ของ iShip
  senderSubdistrict String?
  senderDistrict    String?
  senderProvince    String?
  senderPostcode    String?

  // --- ค่าตั้งต้นของพัสดุ (แก้รายออเดอร์ได้ก่อนยืนยัน) ---
  defaultCourierCode String?
  defaultWeight      Decimal? @db.Decimal(6, 2) // กิโลกรัม
  defaultWidth       Int? // เซนติเมตร
  defaultLength      Int?
  defaultHeight      Int?
  defaultCategoryId  Int? // 0-11, 99 ตามที่ iShip กำหนด
  // 🛑 default false ตั้งใจ (BR-ISHIP-27) — เผลอเปิด COD = เงินจริงที่ร้านจะได้รับผิดจำนวน
  defaultCodEnabled  Boolean  @default(false)
  optOnTime          Boolean  @default(false) // ส่งตรงเวลา
  optBoxShield       Boolean  @default(false) // ประกันกล่อง
  optIsInsured       Boolean  @default(false) // ประกันสินค้า
  optProductValue    Decimal? @db.Decimal(12, 2) // มูลค่าที่เอาประกัน (ใช้เมื่อ optIsInsured)
  optServiceType     Int? // 1=เข้ารับ 2=นำไปส่งเอง; null = ตามตั้งค่าฝั่ง iShip
  defaultRemark      String?

  lastVerifiedAt    DateTime? // ทดสอบ token ผ่านล่าสุดเมื่อไหร่
  // statusSyncedAt: ดึงสถานะพัสดุยกชุดจาก iShip สำเร็จล่าสุดเมื่อไหร่ (feature 00022)
  // เก็บใน DB ไม่ใช่หน่วยความจำ เพราะบน serverless แต่ละคำขออาจคนละ instance —
  // ตัวจับเวลาในหน่วยความจำจะกลายเป็น "ยิงใหม่ทุกคำขอ" โดยไม่มีใครเห็นว่าเกิดขึ้น
  statusSyncedAt    DateTime?
  lastVerifyError   String? // สาเหตุที่ทดสอบไม่ผ่านครั้งล่าสุด
  connectedByUserId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // 🛑 ไม่มีคอลัมน์ยอดเงินคงเหลือของบัญชี iShip โดยเจตนา (BR-ISHIP-53) — เก็บแล้วจะสื่อผิดว่า
  //    Deep เป็นผู้ดูแลเงินก้อนนั้น ทั้งที่เป็นความสัมพันธ์ระหว่างร้านกับ iShip โดยตรง
  @@index([status])
}

// OrderShipment — พัสดุ 1 ใบที่เปิดกับขนส่ง ผูกกับคำสั่งซื้อ 1 รายการ
model OrderShipment {
  id             String  @id @default(uuid())
  orderId        String
  shopId         String // denormalized — query ระดับร้าน (หน้ารายการ/พิมพ์หลายใบ) โดยไม่ต้อง join Order
  provider       String  @default("ISHIP")
  // status: "PENDING" (กำลังสร้าง) | "CREATED" (สำเร็จ) | "CANCELLED" | "FAILED"
  status         String  @default("PENDING")
  // source: "CREATED" = Deep เปิดพัสดุใบนี้เอง | "LINKED" = ร้านเปิดไว้บน iShip แล้วเอามาผูก
  // 🛑 ปุ่มยกเลิกของสองชนิดนี้คนละความหมาย — LINKED ต้องมีทาง "เลิกผูก" ที่ไม่ไปยกเลิก
  //    พัสดุจริงของร้าน ส่วน CREATED ยกเลิกคือยกเลิกกับขนส่งจริง
  source         String  @default("CREATED")
  courierCode    String?
  courierName    String? // ชื่อที่แสดง ณ เวลาสร้าง — cache ไว้ ไม่ re-fetch ทุกครั้ง
  trackingNo     String?
  refCode        String? // data.ref ที่ iShip คืนมา
  externalId     String? // data.id ฝั่ง iShip
  // idempotencyKey: "<orderId>:<attemptGroup>" — ส่งไปเป็น custom_order_id ของ iShip ด้วย (BR-ISHIP-25)
  // 🛑 retry จากใบ FAILED ต้องใช้คีย์เดิม เพื่อว่าถ้าคำขอเดิมสำเร็จฝั่ง iShip แต่ response หายระหว่างทาง
  //    การยิงซ้ำจะไม่เกิดพัสดุใบที่สอง (BR-ISHIP-26). attemptGroup +1 เมื่อยกเลิกใบเดิมเท่านั้น
  idempotencyKey String  @unique

  codAmount  Decimal  @default(0) @db.Decimal(12, 2)
  weight     Decimal? @db.Decimal(6, 2)
  width      Int?
  length     Int?
  height     Int?
  categoryId Int?

  // snapshot: freeze ค่าที่ส่งไปจริง ไม่อ้างอิงสด — ถ้าอ้างอิงสด แล้วร้านแก้ค่าตั้งต้นทีหลัง
  // ประวัติพัสดุเก่าจะเปลี่ยนตาม = อธิบายกับขนส่งไม่ได้ (บทเรียนเดียวกับ Order.depositAmount feat 00017)
  senderSnapshot   Json?
  receiverSnapshot Json?
  optionsSnapshot  Json?

  // สถานะฝั่งขนส่ง — 🛑 คนละชุดกับ Order.status และห้ามไปเปลี่ยน Order.status เอง (BR-ISHIP-40/41)
  carrierStatus     String? // "order_success" | "picked_up" | "delivered" | ...
  carrierStatusText String? // ข้อความไทยที่แสดงต่อผู้ใช้
  carrierStatusAt   DateTime?
  isOverSize        Boolean   @default(false) // ขนส่งวัดได้เกินที่ร้านแจ้ง (จาก webhook)
  isOverWeight      Boolean   @default(false)
  carrierPrice      Decimal?  @db.Decimal(12, 2) // ค่าส่งที่ขนส่งคิดจริง — แสดงเฉย ๆ ไม่ใช่ยอดที่ Deep เก็บ

  labelPrintedAt  DateTime?
  labelPrintCount Int       @default(0)
  // isDryRun: พัสดุจำลองจากโหมดทดสอบ (BR-ISHIP-60/61) — ต้องมีเครื่องหมายบนหน้าจอ
  // และต้องกรองออกจากสถิติทุกชนิด ไม่งั้น KPI เพี้ยนเพราะนับพัสดุที่ไม่มีอยู่จริง
  isDryRun        Boolean   @default(false)

  lastErrorCode    String? // รหัสที่จับกลุ่มแล้วของเรา (TOKEN_INVALID / ADDRESS_INVALID / ...)
  // lastErrorMessage: ข้อความดิบจาก iShip ไว้ให้ทีมงานตรวจสอบ 🛑 ห้ามแสดงตรงต่อผู้ใช้
  // และต้อง redact token ออกก่อนบันทึกทุกครั้ง
  lastErrorMessage String? @db.Text
  attemptCount     Int     @default(0)

  createdByUserId   String? // null = ระบบสร้างเองในโหมด AUTO (BR-ISHIP-28)
  // linkedAt: เวลาที่ร้านกดผูก — ต่างจาก createdAt ซึ่งคือเวลาที่เราบันทึกแถวนี้
  // (พัสดุจริงอาจถูกเปิดไว้ตั้งแต่เมื่อวาน แล้วเพิ่งมาผูกตอนนี้)
  linkedAt          DateTime?
  cancelledByUserId String?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop   Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  // 🛑 partial unique index ที่ Prisma DSL ประกาศไม่ได้ — สร้างด้วย SQL มือใน migration
  //    (unmanaged SQL: `prisma db pull` จะมองไม่เห็นแล้ว DROP ทิ้ง — ห้ามรันเด็ดขาด):
  //    1) OrderShipment_active_order_key  ON ("orderId")    WHERE status <> 'CANCELLED'
  //       = 1 ออเดอร์มีพัสดุที่ยังใช้งานอยู่ได้ใบเดียว แต่ยกเลิกแล้วเปิดใหม่ได้ (BR-ISHIP-22)
  //    2) OrderShipment_trackingNo_key    ON ("trackingNo") WHERE trackingNo IS NOT NULL
  //       = เลขติดตามห้ามซ้ำ แต่ใบที่ยังไม่สำเร็จมี trackingNo null ได้หลายใบ
  @@index([orderId])
  @@index([shopId, status])
  @@index([shopId, source])
}

// ShipmentEvent — ประวัติการเดินทางของพัสดุ (จาก webhook หรือจากการ poll traces)
model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  status     String // รหัสสถานะจากขนส่ง
  statusText String? // ข้อความไทยสั้น
  statusDesc String?  @db.Text // คำอธิบายเต็มจากขนส่ง
  location   String?
  // occurredAt: เวลาที่เกิดเหตุการณ์จริงฝั่งขนส่ง ไม่ใช่เวลาที่เราบันทึก
  occurredAt DateTime
  source     String   @default("WEBHOOK") // "WEBHOOK" | "POLL"
  // dedupeKey: "<status>:<occurredAt epoch>" — กัน webhook ยิงซ้ำแล้วไทม์ไลน์บวม (FR-ISHIP-041)
  dedupeKey  String
  payload    Json? // ข้อมูลดิบไว้ตรวจสอบ (redact ข้อมูลอ่อนไหวก่อนบันทึก)
  createdAt  DateTime @default(now())

  shipment OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, dedupeKey])
  @@index([shipmentId, occurredAt])
}

// ShipmentPickup — คำขอเรียกรถเข้ารับพัสดุ
// 🛑 ระดับร้าน ไม่ใช่ระดับออเดอร์ (FR-ISHIP-051) — รถมารับครั้งเดียวได้หลายกล่อง
model ShipmentPickup {
  id             String  @id @default(uuid())
  shopId         String
  provider       String  @default("ISHIP")
  courierCode    String
  ticketPickupId String? // หมายเลขคำขอฝั่ง iShip
  parcelCount    Int     @default(1)
  pickupAddress  String? // snapshot ที่อยู่ที่ใช้เรียก ณ เวลานั้น
  remark         String?
  // status: "REQUESTED" | "ACCEPTED" | "CLOSED" | "CANCELLED" | "FAILED"
  status         String  @default("REQUESTED")
  staffName      String?
  staffPhone     String?
  timeoutAtText  String? // ช่วงเวลาที่จะเข้ารับ — ข้อความตามที่ขนส่งส่งมา ไม่ parse เป็น date
  ticketMessage  String? @db.Text

  isDryRun         Boolean @default(false)
  lastErrorMessage String? @db.Text

  createdByUserId String
  acceptedAt      DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
}

/// คลิปที่ร้านเลือกมาแสดงบนหน้าร้านสาธารณะ (2026-07-26)
///
/// ร้านไม่ได้ "วาง URL" เอง แต่เชื่อมบัญชีแล้วเลือกจากคลิปของตัวเองที่ระบบดึงมาให้ —
/// จึงการันตีความเป็นเจ้าของโดยอัตโนมัติ เพราะเลือกได้เฉพาะคลิปในบัญชีที่ผ่าน OAuth มาแล้ว
/// (ถ้าให้วาง URL อิสระ ร้านจะเอาคลิปคนอื่นมาอ้างเป็นของตัวเองได้)
model ShopVideo {
  id           String   @id @default(uuid())
  shopId       String
  /// "INSTAGRAM" | "TIKTOK" | "YOUTUBE" — String ตาม convention เดิมของ repo (มิเรอร์ provider ของ ShopChannel)
  provider     String
  /// id/shortcode ของคลิปบนแพลตฟอร์มนั้น ใช้ประกอบ URL ฝังเอง ไม่เก็บ URL ดิบที่ผู้ใช้กำหนด
  videoId      String
  caption      String?  @db.Text
  /// รูปปกที่แพลตฟอร์มให้มา — เก็บไว้แสดงก่อนผู้ชมกดเล่น จะได้ไม่ต้องโหลด iframe ทุกอัน
  thumbnailUrl String?
  /// ชื่อบัญชีต้นทาง (เช่น @oilssm) — บอกผู้ชมว่าคลิปมาจากช่องไหน ไม่ใช่แค่แพลตฟอร์มอะไร
  accountName  String?
  /// ยอด ณ เวลาที่ร้านกดเลือก — เป็น snapshot ไม่ใช่ค่าสด เพราะการยิง API ทุกครั้งที่มีคน
  /// เปิดหน้าร้านจะช้าและชนลิมิตของแพลตฟอร์ม ค่าจะอัปเดตเมื่อร้านกดบันทึกใหม่
  likeCount    Int?
  commentCount Int?
  /// ยอดวิว — ยังเป็น null เสมอสำหรับ Instagram เพราะต้องใช้ scope instagram_manage_insights
  /// ที่ยังไม่ได้ขอ (ทดสอบจริงแล้วได้ error #10) เผื่อไว้ให้ TikTok ที่ video.list ให้ view มาด้วย
  viewCount    Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// กันเลือกคลิปเดิมซ้ำในร้านเดียวกัน
  @@unique([shopId, provider, videoId])
  @@index([shopId, sortOrder])
}

// ============================================================================
// feature 00023 — Chat Auto-Reply (ตอบแชทอัตโนมัติจาก Keyword)
// 6 ตารางใหม่ + คอลัมน์เพิ่มใน Conversation/ChatMessage — additive ล้วน
// SSOT: docs/20 - Features/00023 - Chat Auto-Reply/DATABASE.md (FROZEN CONTRACT)
// ============================================================================

// AutoReplyConfig — การตั้งค่าระดับร้าน 1:1 กับ Shop — แยกตารางแทนเพิ่มคอลัมน์ใน Shop ด้วยเหตุผล
// เดียวกับ ShopAiSetting (SDS TD-001 ของ 00019): Shop ถูกอ่านแทบทุก request การพกค่าที่ใช้เฉพาะ
// ตอนตอบแชทไปด้วยทุก query เป็นการเปลืองเปล่า
model AutoReplyConfig {
  id     String @id @default(uuid())
  // shopId @unique = 1 ร้าน 1 ชุดตั้งค่า บังคับที่ DB ไม่พึ่งวินัยโค้ด และเป็น index ของ query หลักไปในตัว
  shopId String @unique

  // 🛑 DEPRECATED 2026-07-30 — ไม่มีที่อ่านค่านี้แล้ว (user: "ไม่มีแล้วสิ ปิดทั้งหมด
  // ให้ user ปิดเอง ในแต่ละ row") สวิตช์ระดับร้านซ้ำกับ AutoReplyKeyword.status และสร้าง
  // กับดัก "แถวเป็น LIVE แต่เงียบเพราะสวิตช์ร้านปิดอยู่คนละที่"
  // ความปลอดภัยเดิม (BR-AR ระดับ 0) ยังอยู่: กลุ่มคำที่สร้างใหม่เป็น OFFLINE เสมอ
  // ไม่ลบคอลัมน์เพราะเลี่ยง migration ทำลายข้อมูลรอบสองในวันเดียว — ลบได้ในรอบทำความสะอาด
  isEnabled Boolean @default(false)

  // 🛑 โหมดทดสอบ "ระดับร้าน" ถูกยกเลิก 2026-07-29 (user: "เอาระดับทั้งหมดออกไปเลย")
  // ของเดิมเป็นสวิตช์ครอบทั้งร้าน + allowlist ที่ Conversation ทำให้ต้องเข้าใจ 2 ชั้นถึงจะ
  // ตอบได้ว่า "ทำไมชุดนี้ไม่ตอบ" ตอนนี้ย้ายไปอยู่ที่ AutoReplyKeyword.status + ตารางเธรด
  // ทดสอบรายชุด (AutoReplyKeywordTestThread) — ชั้นเดียว อ่านจบที่กลุ่มคำนั้นตัวเดียว

  // --- การหยุดเมื่อพนักงานตอบ (FR-016) ---
  // "30M" | "2H" | "MANUAL" (จนกว่าจะเปิดเอง) | "UNTIL_RESOLVED" (จนกว่าเธรดจะถูกปิด)
  // String ไม่ใช่ Prisma enum ตาม convention เดิมทั้งโปรเจกต์ (Order.status/Shop.kind/Product.type)
  // เลี่ยง ALTER TYPE ทุกครั้งที่เพิ่มตัวเลือก — validate ที่ Valibot เท่านั้น ไม่มี DB CHECK
  humanTakeoverPauseMode String @default("2H")

  // --- การจำกัดการตอบ (FR-018) ---
  keywordCooldownSec        Int @default(300) // กลุ่มคำเดิมห้ามตอบซ้ำในเธรดเดิมภายในกี่วินาที
  maxRepliesPerConversation Int @default(10) // ครบแล้วหยุดและส่งต่อพนักงาน

  // --- อายุบริบทโฆษณา (FR-013) ---
  // "UNTIL_RESOLVED" | "HOURS" | "UNTIL_NEW_PRODUCT"
  adsContextMode  String @default("UNTIL_RESOLVED")
  adsContextHours Int? // ใช้เมื่อ adsContextMode = "HOURS" เท่านั้น

  // --- สัญญาณส่งต่อพนักงาน (FR-019 / AC-019-02) ---
  // TEXT[] คอลัมน์เดียว ไม่ทำ table แยก — ลำดับไม่มีความหมาย ไม่มี query ที่ต้อง join/aggregate รายคำ
  // (แบบเดียวกับ ExternalContact.tags/phones และ QuickMessage.imageFileIds)
  handoffPhrases String[] @default([])

  // --- เพดานค่าใช้จ่าย AI Enhance ต่อวัน (phase `00023-ai-enhance`, BR-AR-35) ---
  //
  // ตั้งระดับร้านไม่ใช่รายกลุ่มคำ ต่างจาก aiEnhanceEnabled โดยเจตนา: นี่คือเรื่องงบประมาณรวม
  // ของร้าน ไม่ใช่พฤติกรรมของกลุ่มใดกลุ่มหนึ่ง — ร้านคิดเป็น "วันนี้ยอมจ่ายเท่าไหร่" ก้อนเดียว
  //
  // ค่าเริ่มต้น 50 บาท (user เคาะ 2026-08-01): ไม่ใช่ 0 เพราะจะบล็อกฟีเจอร์ตั้งแต่วันแรก
  // และไม่ใช่ไม่จำกัดเพราะขัดเจตนาที่กลัวบิลบานปลายพอดี
  /// AI ChatBot — ข้อความที่ไม่ตรงกลุ่มคำไหนเลย ให้ AI อ่านคลังคำตอบแล้วตอบเอง
  /// (แทนที่จะเงียบ) · user ตัดสิน 2026-08-01 ให้เป็นสวิตช์ระดับร้าน
  ///
  /// ทำไมอยู่ระดับร้านไม่ใช่รายกลุ่มคำ: มันตัดสินว่า "เมื่อ**ไม่เข้า**กลุ่มไหนเลยจะทำอะไร"
  /// ซึ่งไม่มีกลุ่มให้แขวน — ต่างจาก AI Enhance ที่ตัดสินว่า "เมื่อเข้ากลุ่มนี้แล้วทำอะไร"
  /// และไม่สร้างกับดักเดิม เพราะมันได้แค่ **เพิ่มคำตอบตรงที่เคยเงียบ** ปิดปากกลุ่มไหนไม่ได้
  aiChatbotEnabled Boolean @default(false)

  /// สถานะ ChatBot — "OFFLINE" | "TEST" | "LIVE" (user สั่ง 2026-08-01)
  ///
  /// ใช้คำเดียวกับ `AutoReplyKeyword.status` โดยเจตนา: ร้านเรียนรู้ความหมายไปแล้วรอบหนึ่ง
  /// จากกลุ่มคำ การตั้งชื่อใหม่ให้ของที่ทำงานเหมือนกันคือการบังคับให้เรียนซ้ำ
  ///   OFFLINE = ไม่ทำงานเลย · TEST = ตอบเฉพาะแชทที่เลือกไว้ · LIVE = ตอบลูกค้าจริงทุกคน
  ///
  /// NOTE: `aiChatbotEnabled` ด้านบนเป็นของเดิมก่อนมี 3 สถานะ — ยังคงไว้เพื่อไม่ให้โค้ดที่
  /// อ่านค่านั้นพังระหว่างเปลี่ยนผ่าน แต่ตัวตัดสินจริงคือ `aiChatbotStatus`
  aiChatbotStatus String @default("OFFLINE")

  /// ให้ AI ขัดเกลาคำตอบของ Auto Reply ก่อนส่ง — เป็น "option เสริม" ในเมนู ChatBot
  /// (user ตัดสิน 2026-08-01: ย้ายจากสวิตช์รายกลุ่มคำขึ้นมาเป็นระดับร้าน)
  ///
  /// NOTE: `AutoReplyKeyword.aiEnhanceEnabled` ยังอยู่ในสคีมาแต่ **เลิกใช้แล้ว** — ไม่ลบทิ้ง
  /// เพราะการถอดคอลัมน์บนฐานที่ใช้งานจริงแพงกว่าการปล่อยให้นอนเฉย และเผื่อวันหนึ่ง
  /// ต้องการ override รายกลุ่มจริง ๆ จะได้ไม่ต้อง ALTER รอบสอง
  aiEnhanceEnabled Boolean @default(false)

  /// ช่วงเวลาที่ให้ ChatBot ทำงาน — null = ตลอดเวลา (รูปแบบเดียวกับ activeSchedule ของบอท)
  /// เก็บเป็น HH:mm เวลาไทย · ข้ามเที่ยงคืนได้ (18:00-09:00 = ทำงานตอนร้านหลับ)
  aiChatbotStartTime String?
  aiChatbotEndTime   String?

  /// น้ำเสียงของ AI ChatBot (null = ใช้ค่ากลาง) — แยกจาก aiTone รายกลุ่มคำ
  aiChatbotTone String? @db.Text

  aiDailyCapBaht Int @default(50)

  // ร้านยอมจ่าย SMS 1 บาทเพื่อให้เตือนตอนใช้ถึง 80% ไหม — default ปิด เพราะการเตือนเรื่อง
  // ค่าใช้จ่ายด้วยของที่มีค่าใช้จ่ายเองต้องเป็นการเลือกของร้าน ไม่ใช่สิ่งที่ระบบตัดสินให้
  aiCapAlertSmsOptIn Boolean @default(false)

  // วัน (ปฏิทินไทย YYYY-MM-DD) ที่ส่งเตือน 80% ไปแล้ว — กันเตือนซ้ำทุกข้อความหลังข้ามเส้น
  // เก็บเป็นวันไม่ใช่ boolean เพราะต้องรีเซ็ตเองเมื่อขึ้นวันใหม่โดยไม่ต้องมี cron มาล้าง
  aiCapAlertedDay String?

  // --- เวลาทำงานของระบบ (user 2026-07-31: "บางคนอยากให้ทำงานช่วง 18.00-9.00 เพื่อแทน
  //     admin ตอนหลับ / บางคนอยากให้ทำทั้งวัน") ---
  //
  // ตั้งระดับร้าน ไม่ใช่รายกลุ่มคำ ตั้งใจ: ตารางนี้ตอบคำถามว่า "ตอนไหนไม่มีคนเฝ้าร้าน"
  // ซึ่งเป็นคุณสมบัติของร้าน ไม่ใช่ของกลุ่มคำ
  //
  // "ALWAYS" = ทำงานตลอด (ค่าเริ่มต้น — ร้านที่มีอยู่แล้วต้องไม่เปลี่ยนพฤติกรรมกะทันหัน)
  // "WINDOW" = ทำงานเฉพาะช่วงเวลา + วันที่กำหนด
  activeScheduleMode String @default("ALWAYS")

  // นาทีนับจากเที่ยงคืน **เวลาไทย** (0-1439); 18:00 = 1080, 09:00 = 540
  //
  // 🛑 เก็บเป็นนาที ไม่ใช่ DateTime/TIME ตั้งใจ: เซิร์ฟเวอร์รัน UTC การเก็บเป็นชนิดเวลาจะพา
  // ให้ต้องแปลง tz ทุกที่ที่อ่าน แล้วเพี้ยน 7 ชั่วโมงแบบเงียบ ๆ. Int = ค่าที่ตีความได้ทางเดียว
  //
  // 🛑 end <= start หมายถึงช่วงข้ามเที่ยงคืน (18:00→09:00 ของวันรุ่งขึ้น) ไม่ใช่ค่าผิด —
  // เป็นเคสหลักที่ user ขอด้วยซ้ำ ("แทน admin ตอนหลับ")
  activeStartMin Int? // null เมื่อ mode = ALWAYS
  activeEndMin   Int?

  // bitmask วันที่ทำงาน — จันทร์=1, อังคาร=2, พุธ=4, ..., อาทิตย์=64; 127 = ทุกวัน
  // ช่วงข้ามคืนยึด **วันที่เริ่ม** เป็นเจ้าของช่วง (ตั้งจันทร์ 18:00-09:00 = จันทร์คืนถึงอังคารเช้า)
  activeDays Int @default(127)

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("AutoReplyConfigUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// AutoReplyKeyword — กลุ่มคำ
model AutoReplyKeyword {
  id     String @id @default(uuid())
  shopId String
  name   String // ชื่อกลุ่มที่ร้านตั้งเอง เช่น "สนใจสินค้า"

  // "EXACT" | "CONTAINS" | "STARTS_WITH"
  // FUZZY เลื่อนไปเฟส 2 (PRD §5) — ค่าใหม่เพิ่มได้โดยไม่ต้อง migrate เพราะเป็น String
  matchType String @default("CONTAINS")

  // มากกว่า = ถูกเลือกก่อน (AC-003-02, เกณฑ์ที่ 1 ของ BR-AR-04)
  priority Int @default(100)

  // สถานะของกลุ่มคำ — 3 ค่า ค่าเดียวจบ (user 2026-07-29 แทน isActive+mode ที่แยกกันแล้วสับสน)
  //   "OFFLINE" = ไม่ตอบใครเลย ตั้งค่าไว้เฉย ๆ (ลองได้ผ่านแผงพรีวิวในหน้าตั้งค่า)
  //   "TEST"    = ตอบเฉพาะเธรดที่ระบุไว้ใน AutoReplyKeywordTestThread ของกลุ่มนี้เท่านั้น
  //               🛑 ต้องมีอย่างน้อย 1 เธรดเสมอ ไม่งั้น TEST จะกลายเป็น OFFLINE โดยปริยาย
  //   "LIVE"    = ตอบทุกเธรดตามเงื่อนไขที่ตั้งไว้
  //
  // 🛑 default OFFLINE ตั้งใจ: กลุ่มที่เพิ่งสร้างยังไม่มีคำ/คำตอบ ต้องไม่แตะลูกค้าจนกว่าร้านจะสั่ง
  // String ไม่ใช่ enum ตาม convention เดิมทั้งโปรเจกต์ — validate ที่ Valibot
  status String @default("OFFLINE")

  // 🛑 ยัง **ไม่มีที่ไหนในโค้ดอ่านค่านี้** — ห้ามเข้าใจว่าเปิดใช้ได้แล้ว
  // user ตัดสิน 2026-07-31: "ตรงตัวก่อน ความคล้ายเปิดทีหลัง" (Scope Baseline 00023-qna A1)
  // การจับคู่คลังคำถามรอบแรกเป็น EXACT ล้วน ซึ่งปิดคิว NO_KEYWORD_MATCH ได้ 42% จากข้อมูลจริง
  // ใส่คอลัมน์มาพร้อม migration รอบนี้เพราะ dev DB = prod DB — กลับมา ALTER รอบสองแพงกว่า
  qnaSimilarityEnabled Boolean @default(false)

  /// AI Enhance — ให้ AI เรียบเรียงคำตอบสำเร็จรูปของกลุ่มนี้ก่อนส่ง (phase `00023-ai-enhance`, BR-AR-31)
  ///
  /// ค่าเริ่มต้น false โดยเจตนา: กลุ่มที่มีอยู่แล้วทุกกลุ่มบน prod ต้องมีพฤติกรรมเหมือนเดิม
  /// ไม่มี latency เพิ่ม ไม่มีการเรียก AI ไม่มีการหักเงิน จนกว่าร้านจะกดเปิดเอง
  ///
  /// อยู่ระดับกลุ่มคำไม่ใช่ระดับร้าน (มติ user รอบแรกข้อ 1) — บางกลุ่มเป็นคำตอบที่ต้องส่ง
  /// คำต่อคำ (เงื่อนไขรับประกัน/ราคา) การให้ AI แต่งใหม่คือความเสี่ยง ส่วนบางกลุ่มเป็นคำ
  /// ทักทายที่แต่งได้อิสระ — สวิตช์เดียวทั้งร้านจึงตอบโจทย์ไม่ได้
  aiEnhanceEnabled Boolean @default(false)

  /// น้ำเสียงที่ให้ AI ใช้เรียบเรียง (phase `00023-ai-enhance`) — null = ใช้ค่ากลาง "สุภาพ เป็นกันเอง"
  ///
  /// เก็บเป็นข้อความอิสระไม่ใช่ enum โดยเจตนา: ร้านแต่ละแบบมีน้ำเสียงต่างกันมาก
  /// (ร้านอะไหล่มอเตอร์ไซค์ vs ร้านเครื่องสำอาง) และคำที่ร้านเขียนเองจะถูกส่งเข้า prompt ตรง ๆ
  /// ได้ผลดีกว่าการให้เลือกจากรายการที่เราคิดแทน — UI มีปุ่มลัดให้กดเติมคำที่ใช้บ่อย
  aiTone String? @db.Text

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop        Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  phrases     AutoReplyPhrase[]
  qnas        AutoReplyQna[] // คลังคำถาม-คำตอบของกลุ่มนี้ (วิธีจับคู่ทางที่สอง)
  guardrails  AutoReplyGuardrail[] // กฎห้ามตอบของกลุ่มนี้ (มีผลเมื่อ aiEnhanceEnabled = true)
  // onDelete Cascade — ลบกลุ่มคำ ลบกฎของกลุ่มนั้นด้วย (กฎที่ไม่มีกลุ่มไม่มีความหมาย)
  rules       AutoReplyRule[]
  logs        AutoReplyLog[]
  testThreads AutoReplyKeywordTestThread[]

  @@unique([shopId, name]) // AC-001-04 ชื่อกลุ่มห้ามซ้ำในร้านเดียวกัน
  @@index([shopId, status, priority]) // query หลัก: โหลดกลุ่มที่ทำงานอยู่ของร้านเรียงตามลำดับความสำคัญ
}

/// แชทที่ใช้ทดสอบ ChatBot — มีผลเฉพาะตอน `AutoReplyConfig.aiChatbotStatus = "TEST"`
///
/// โครงเดียวกับ `AutoReplyKeywordTestThread` ของกลุ่มคำ ต่างกันที่ผูกระดับร้าน
/// เพราะ ChatBot เป็นสวิตช์ระดับร้าน ไม่มีกลุ่มคำให้ผูก
model AiChatbotTestThread {
  id             String   @id @default(uuid())
  shopId         String
  conversationId String
  createdAt      DateTime @default(now())

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([shopId, conversationId]) // เลือกแชทเดิมซ้ำไม่ได้
  @@index([shopId])
}

/// กฎห้ามตอบ (Guardrails) ของกลุ่มคำหนึ่ง ๆ — phase `00023-ai-enhance` (BR-AR-32/33/34)
///
/// "AI ห้ามพูดถึงอะไร" — คนละกลไกกับ `AutoReplyConfig.handoffPhrases` ซึ่งดูคำที่ **ลูกค้า**
/// พิมพ์เข้ามา ตัวนี้ดูสิ่งที่ **บอทกำลังจะพูด** ชนแล้วไม่ส่งอะไรเลยและส่งต่อคน
///
/// เก็บเป็นแถวต่อข้อ ไม่ใช่ text ก้อนเดียว เพราะร้านต้องลบทีละข้อได้ และต้องรู้ว่าข้อไหน
/// มาจากชุดเริ่มต้นของ SafePay (`isFromDefaultSet`) เพื่อบังคับกฎ "ข้อที่ร้านลบแล้วห้ามเติมกลับ"
/// ตอน SafePay อัปเดตชุดเริ่มต้นในอนาคต (AC-027-04)
model AutoReplyGuardrail {
  id        String @id @default(uuid())
  shopId    String // ซ้ำกับ keyword.shopId โดยเจตนา — ทุก query ต้อง scope shopId ได้โดยไม่ join
  /// null = กฎระดับร้าน ใช้กับ AI ChatBot (ข้อความที่ไม่เข้ากลุ่มไหนเลย จึงไม่มีกลุ่มให้ผูก)
  keywordId String?

  /// ข้อความกฎที่ร้านอ่านออก เช่น "ห้ามต่อรองราคา" — ใช้ทั้งแสดงใน UI และใส่ใน prompt ของด่านตรวจ
  rule String @db.Text

  /// คำ/วลีสำหรับ denylist ชั้นแรก (ไม่มีต้นทุน AI) — ว่างได้ ถ้าข้อนี้ตรวจด้วย AI อย่างเดียว
  denyPhrases String[] @default([])

  /// มาจากชุดเริ่มต้น 6 ข้อของ SafePay หรือร้านพิมพ์เอง — copy-by-value ตอนเปิดสวิตช์ครั้งแรก
  isFromDefaultSet Boolean @default(false)

  isActive Boolean @default(true)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop    Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  keyword AutoReplyKeyword? @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, isActive]) // query หลัก: โหลดกฎที่ใช้งานอยู่ของกลุ่มที่กำลังจะตอบ
  @@index([shopId]) // ทางกลับ: กฎทั้งหมดของร้าน (หน้ารวม/ตรวจสอบ)
}

/// เธรดที่ใช้ทดสอบของกลุ่มคำหนึ่ง ๆ (user 2026-07-29 "ให้ตั้งค่าทดสอบได้ทีละอัน")
///
/// มีผลเฉพาะตอน AutoReplyKeyword.status = "TEST" — กลุ่มนั้นจะตอบเฉพาะเธรดที่อยู่ในตารางนี้
/// ทำให้ทดสอบชุดใหม่กับแชทของตัวเองได้ โดยชุดที่ LIVE อยู่ยังตอบลูกค้าจริงตามปกติในเวลาเดียวกัน
///
/// ทำไมเป็นตารางแยกไม่ใช่ String[] บน keyword: ต้อง join กับ Conversation เพื่อโชว์ชื่อคู่สนทนา
/// ในหน้าตั้งค่า และต้องลบทิ้งอัตโนมัติเมื่อเธรดถูกลบ (FK cascade) — array ทำสองอย่างนี้ไม่ได้
model AutoReplyKeywordTestThread {
  id             String   @id @default(uuid())
  keywordId      String
  conversationId String
  createdAt      DateTime @default(now())

  keyword      AutoReplyKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([keywordId, conversationId]) // เธรดเดิมเพิ่มซ้ำในกลุ่มเดิมไม่ได้ — บังคับที่ DB ไม่พึ่งวินัยโค้ด
  @@index([conversationId]) // ทางกลับ: เธรดนี้ถูกใช้ทดสอบกลุ่มไหนบ้าง (ใช้ตอน match)
}

// AutoReplyPhrase — คำตรวจจับภายในกลุ่ม
model AutoReplyPhrase {
  id        String @id @default(uuid())
  keywordId String

  phrase String // คำที่ร้านพิมพ์ (เก็บของเดิมไว้แสดงใน UI)

  // normalizedPhrase: ผ่าน normalize ตัวเดียวกับที่ใช้กับข้อความลูกค้า (SRS — normalizeMessage)
  // 🛑 เก็บที่ DB ไม่ normalize ตอน match: ถ้า normalize ทุกครั้งที่เทียบ จะเสียเวลาซ้ำทุกข้อความ
  // และที่สำคัญกว่าคือใช้บังคับ unique กันคำซ้ำที่ "ต่างกันแค่รูปแบบ" ได้ (AC-002-03)
  normalizedPhrase String

  createdAt DateTime @default(now())

  keyword AutoReplyKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, normalizedPhrase]) // AC-002-03 คำซ้ำในกลุ่มเดียวกันต้องถูกปฏิเสธ
  @@index([keywordId])
}

// AutoReplyRule — กฎคำตอบ ทุกระดับอยู่ตารางเดียว โดยเงื่อนไขเป็นคอลัมน์ nullable — ตอบโจทย์ PRD §20
// ที่ห้ามทั้ง "คอลัมน์ตายตัวเกินไป" และ "JSON จน query/index ไม่ได้"
model AutoReplyRule {
  id     String @id @default(uuid())
  shopId String

  // keywordId = null → กฎคำตอบกลาง (ระดับ 7 = ของเพจ ถ้า shopChannelId ไม่ null, ระดับ 8 = ของร้าน ถ้า null)
  keywordId String?

  // --- เงื่อนไข 3 มิติ (null = ไม่จำกัดมิตินั้น) ---
  shopChannelId String? // เงื่อนไขเพจ
  adId          String? // เงื่อนไขโฆษณา — String ดิบ ไม่ FK เพราะโฆษณาไม่ใช่ entity ในระบบเรา
  adLabel       String? // ชื่อกำกับที่ร้านตั้งเอง (AC-007-01) — Meta ไม่ให้ชื่อแคมเปญ/AdSet
  productId     String? // เงื่อนไขสินค้า

  replyText String @db.Text // 🛑 ข้อความที่ส่งถึงลูกค้าตรงตัวทุกอักษร ห้ามระบบดัดแปลง (BR-AR หลัก)

  // รูปแนบ (storage fileId) สูงสุด 5 บังคับที่ Valibot — user สั่ง 2026-07-31 "Auto Reply ต้องใส่รูปได้"
  // รูปแบบเดียวกับ QuickMessage.imageFileIds: TEXT[] คอลัมน์เดียว ลำดับในอาร์เรย์ = ลำดับที่ส่ง
  //
  // 🛑 Messenger attachment ไม่มี text ในตัว ⇒ "5 รูป + ข้อความ" = ลูกค้าได้รับ 6 ข้อความรวด
  //    และแต่ละชิ้นล้มเหลวแยกกันได้แบบถอนคืนไม่ได้ — ดู SRS TFR-036 ว่าต้องนับสำเร็จ/ล้มเหลวยังไง
  //
  // ⚠️ คอลัมน์นี้ลงมาก่อน UI: ช่องใส่รูปในหน้าแก้ไขกลุ่มคำยังทำไม่ได้เพราะงาน v3 ถือ
  //    KeywordEditorClient.tsx อยู่ (user ตัดสิน A5 — ทำ backend ก่อน รอ v3 ปิดค่อยเติม UI)
  imageFileIds String[] @default([])

  // specificity: คะแนนความเฉพาะเจาะจง คำนวณตอนเขียนเสมอ (service layer, invariant)
  //   = (shopChannelId != null ? 4 : 0) + (adId != null ? 2 : 0) + (productId != null ? 1 : 0)
  // bitmask นี้เรียงลำดับตรงกับ AC-009-01 พอดีทุกระดับ:
  //   7=K+เพจ+โฆษณา+สินค้า  6=K+เพจ+โฆษณา  5=K+เพจ+สินค้า  4=K+เพจ  1=K+สินค้า  0=K กลาง
  // (2=K+โฆษณาไม่ระบุเพจ และ 3=K+โฆษณา+สินค้า ไม่อยู่ในลิสต์ของ PRD แต่เรียงลงตัวเองระหว่าง 4 กับ 1)
  // 🛑 เก็บเป็นคอลัมน์ไม่คำนวณตอน query — ต้องใช้ ORDER BY ที่ index ได้ และต้องได้ผลเดิมทุกครั้ง (AC-011-03)
  specificity Int

  isActive    Boolean   @default(true)
  activeFrom  DateTime? // ตารางเวลาเปิดใช้ (null = ไม่จำกัด)
  activeUntil DateTime?

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  keyword     AutoReplyKeyword? @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  // SetNull ทั้งคู่: ถอดเพจ/ลบสินค้า ต้องไม่ลบกฎทิ้ง (AC-006-05, AC-008-03) — กฎกลายเป็นกว้างขึ้น
  // แล้ว service ตัดสินเองว่ายังใช้ได้ไหม ดีกว่าข้อมูลที่ร้านตั้งไว้หายเงียบ ๆ
  shopChannel ShopChannel?      @relation(fields: [shopChannelId], references: [id], onDelete: SetNull)
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  logs        AutoReplyLog[]
  // 🛑 unique constraint ที่ต้องบังคับจริง (AC-006-02 "1 กลุ่มคำ 1 คำตอบต่อ 1 เพจ") เขียนเป็น
  // `CREATE UNIQUE INDEX ... NULLS NOT DISTINCT` ด้วยมือใน migration.sql — Prisma DSL
  // `@@unique([shopId, keywordId, shopChannelId, adId, productId])` ประกาศได้ แต่ Postgres ถือว่า
  // NULL ต่างกันเสมอ ทำให้กฎซ้ำที่มี NULL หลุดผ่านได้ (ดู DATABASE.md §3.4 ท้ายตาราง)

  // query หลักของ rule resolution: กฎที่เปิดใช้ของกลุ่มคำนี้ เรียงเฉพาะเจาะจงมากก่อน
  @@index([shopId, keywordId, isActive, specificity])
  @@index([shopId, shopChannelId, adId])
  @@index([productId])
}

// AutoReplyJob — ตารางที่สำคัญที่สุดของฟีเจอร์นี้ — เป็นทั้งคิวงานและกลไกกันตอบซ้ำในตัวเดียว
model AutoReplyJob {
  id String @id @default(uuid())

  // 🛑 chatMessageId @unique = หัวใจของ BR-AR-21 / AC-017-01 "หนึ่งข้อความ หนึ่งคำตอบ"
  // ข้อความลูกค้า 1 แถว สร้างงานได้ครั้งเดียวตลอดกาล — Meta redeliver / cron ทำซ้ำ / after() ทำงาน
  // พร้อมกับ sweeper ล้วนชนที่ constraint นี้แล้วจบ ไม่ต้องพึ่งวินัยของโค้ดหรือ distributed lock
  // (ใช้หลักการเดียวกับ ChatMessage.externalMessageId @unique ที่พิสูจน์แล้วใน feature 00018)
  chatMessageId String @unique

  conversationId String
  shopId         String

  // "PENDING" | "PROCESSING" | "DONE" | "FAILED" | "SKIPPED"
  status String @default("PENDING")

  attempts  Int       @default(0)
  // lockedAt/lockedBy: กัน worker 2 ตัวหยิบงานเดียวกัน (after() กับ cron sweeper)
  // claim ด้วย conditional updateMany (WHERE status='PENDING') แบบเดียวกับ wallet.service deduct
  lockedAt  DateTime?
  lockedBy  String?
  lastError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message      ChatMessage  @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, createdAt]) // cron sweeper: หางานค้างเรียงเก่าสุดก่อน
  @@index([conversationId, createdAt])
}

// AutoReplyLog — บันทึกการตัดสินใจทุกครั้ง ทั้งตอบและไม่ตอบ
model AutoReplyLog {
  id             String  @id @default(uuid())
  shopId         String
  conversationId String
  chatMessageId  String? // ข้อความขาเข้าที่เป็นต้นเหตุ (SetNull — ลบข้อความไม่ลบบันทึก)

  // --- สิ่งที่เห็นและตีความ ---
  rawText        String? @db.Text // ข้อความต้นฉบับ
  normalizedText String? @db.Text // หลัง normalize (AC-010-06 — ใช้ debug ว่าทำไมไม่ match)

  // --- ผลการจับคู่ ---
  keywordId     String?
  matchedPhrase String?
  matchType     String?
  // เกณฑ์ที่ทำให้ชนะ + กลุ่มที่แพ้ (AC-011-04) — Json เพราะเป็นข้อมูลวินิจฉัย
  // ไม่มี query ไหนกรองด้วยเนื้อในของมัน (มิเรอร์ ChatMessage.scamMatchedRules)
  matchTrace    Json?

  // --- กฎที่ถูกเลือก ---
  ruleId          String?
  resolutionLevel String? // เช่น "KEYWORD_PAGE_AD" — ค่าคงที่ดู DATABASE.md §3.8

  // --- บริบท ณ เวลาตัดสินใจ (snapshot ไม่ join ย้อนหลัง) ---
  shopChannelId String?
  adId          String?
  productId     String?

  // --- ผลลัพธ์ ---
  // "REPLIED" | "SKIPPED" | "HANDOFF" | "FAILED"
  decision   String
  // 🛑 บังคับมีค่าเมื่อ decision != "REPLIED" (AC-024-02) — บันทึกเฉพาะตอนตอบทำให้ debug
  // คำถามที่ร้านถามบ่อยที่สุด ("ทำไมไม่ตอบ") ไม่ได้เลย. ค่าคงที่ดู DATABASE.md §3.8
  skipReason String?

  replyText         String? @db.Text // ข้อความที่ส่งจริง
  outboundMessageId String? // ChatMessage ฝั่งขาออกที่เกิดจากการตอบครั้งนี้

  isTest       Boolean @default(false) // ตอบในโหมดทดสอบ (AC-021-05 กรองแยกได้)
  durationMs   Int?
  errorMessage String? @db.Text

  // --- feature 00023 phase 00023-qna (2026-07-31) ---
  // "KEYWORD" = เข้ากลุ่มเพราะคำตรงตัว | "QNA" = เข้ากลุ่มเพราะข้อในคลังคำถาม
  //
  // 🛑 null = แถวที่บันทึกก่อน phase นี้ ต้องอ่านว่า "KEYWORD" เสมอ และ **ห้าม backfill ทับ**
  // การ backfill จะทำให้แยกไม่ออกระหว่างแถวที่ "รู้จริง" กับแถวที่ "เดาให้" ซึ่งเป็นสิ่งเดียวที่
  // ตารางบันทึกมีไว้ทำ (ป้าย DeepBot ในห้องแชทอ่านคอลัมน์นี้ตรง ๆ เพื่อบอกที่มาของคำตอบ)
  matchedVia String?
  // ข้อในคลังที่ถูกใช้ตอบครั้งนั้น — SetNull เพราะลบข้อในคลังไม่ควรลบบันทึกว่าเคยตอบด้วยข้อนั้น
  qnaId      String?

  createdAt DateTime @default(now())

  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  keyword      AutoReplyKeyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  rule         AutoReplyRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  qna          AutoReplyQna?     @relation(fields: [qnaId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt]) // หน้ารายการบันทึกของร้าน
  @@index([conversationId, createdAt]) // ดูประวัติของเธรดเดียว
  @@index([shopId, decision, createdAt]) // กรอง "ที่ไม่ตอบ" / "ที่พัง"
  @@index([shopId, keywordId, createdAt]) // กลุ่มคำไหนถูกใช้บ่อย
  @@index([shopId, adId, createdAt]) // โฆษณาไหนสร้างบทสนทนาสูง
}

// ---------------------------------------------------------------------------
// feature 00023 phase `00023-qna` (2026-07-31) — คลังคำถาม-คำตอบ + คิวคำถามที่ตอบไม่ได้
// SSOT: docs/20 - Features/00023 - Deep Chat-Bot Assistant/DATABASE.md §3.9-§3.11
//       docs/scope/2026-07-31-00023-qna-library-scope-baseline.md
// ---------------------------------------------------------------------------

/// คลังคำถาม-คำตอบ **ของกลุ่มคำ** ไม่ใช่คลังกลางของร้าน (user ตัดสิน 2026-07-31)
///
/// เป็น "วิธีจับคู่ทางที่สอง": AutoReplyPhrase จับตรงตัวตาม matchType ของกลุ่ม ส่วนตารางนี้จับ
/// ทั้งประโยคแล้วมีคำตอบของตัวเอง — ต่างจาก AutoReplyRule ตรงที่ 1 กลุ่มมีได้หลายร้อยข้อ
/// แต่ละข้อคำตอบต่างกัน ในขณะที่ rule คือคำตอบเดียวของกลุ่มที่แตกตามเงื่อนไข เพจ/โฆษณา/สินค้า
///
/// ทำไมต้องอยู่ในกลุ่ม ไม่ใช่คลังกลาง: ของที่คุมคำตอบ (น้ำเสียง/กฎห้ามตอบ/ขอบเขตสินค้า ใน AI Enhance
/// เฟสหน้า + สถานะ LIVE/TEST/OFFLINE + ตารางเวลา + cooldown) ทั้งหมดอยู่ที่กลุ่ม ถ้าคลังอยู่นอกกลุ่ม
/// มันจะกลายเป็นช่องทางที่ตอบลูกค้าได้โดยไม่มีอะไรคุมเลย
model AutoReplyQna {
  id String @id @default(uuid())
  // ซ้ำกับ keyword.shopId ตั้งใจ — ทุก query ของหน้าจัดการและของ matcher กรองด้วย shopId ตรง ๆ
  // ไม่ต้อง join กลับไปที่ AutoReplyKeyword ทุกครั้ง (แนวเดียวกับ AutoReplyRule.shopId)
  shopId    String
  /// null = ข้ออยู่ในคลังกลางของร้าน ไม่ผูกกลุ่มคำใด (user ตัดสิน 2026-08-01)
  ///
  /// เดิมบังคับผูกกลุ่มคำเพราะออกแบบให้เป็น "วิธีจับคู่ทางที่สอง" ของกลุ่มนั้น ๆ
  /// พอคลังกลายเป็นความรู้ของ ChatBot ที่ตอบทุกคำถาม การบังคับผูกกลุ่มจึงไม่มีความหมาย
  /// ข้อที่ยังผูกกลุ่มอยู่ยังทำงานเหมือนเดิมทุกอย่าง (จับคู่ตรงตัวในกลุ่มนั้น)
  keywordId String?

  question String @db.Text // คำถามที่ร้านพิมพ์ (เก็บของเดิมไว้แสดงใน UI)

  // ผ่าน normalizeMessage() ตัวเดียวกับ AutoReplyPhrase.normalizedPhrase และข้อความลูกค้า
  // 🛑 คำเตือนเดียวกับ AutoReplyPhrase: แก้ normalizeMessage เมื่อไหร่ คอลัมน์นี้ stale ทั้งตาราง
  //    ต้อง backfill พร้อม deploy รอบเดียวกัน (ดูหัวไฟล์ src/lib/auto-reply-normalize.ts)
  normalizedQuestion String

  answer String @db.Text // 🛑 ส่งถึงลูกค้าตรงตัวทุกอักษร ห้ามระบบดัดแปลง (เหมือน AutoReplyRule.replyText)

  // รูปแนบ สูงสุด 5 บังคับที่ Valibot — ดูคำเตือนเรื่อง "6 ข้อความรวด" ที่ AutoReplyRule.imageFileIds
  imageFileIds String[] @default([])

  isActive Boolean @default(true)

  // นับการถูกใช้ตอบจริง — ใช้ทั้งตัวกรอง "ไม่เคยถูกใช้" และคอลัมน์ "N ครั้ง" ในหน้าจัดการ
  // 🛑 เก็บเป็นคอลัมน์ ไม่ COUNT จาก AutoReplyLog ตอน query: AutoReplyLog เป็นตารางที่โตเร็วที่สุด
  //    ในระบบ การ COUNT ต่อแถวคลังทุกครั้งที่เปิดหน้า = N+1 บนตารางที่ใหญ่ที่สุด
  useCount   Int       @default(0)
  lastUsedAt DateTime?

  // "MANUAL" (ร้านพิมพ์เอง) | "QUEUE" (แปลงจากคิว/จากห้องแชท) | "IMPORT" (นำเข้าไฟล์)
  // ไม่ใช่ของประดับ — ใช้ตอบว่า "คลังโตขึ้นจากงานประจำวันจริงไหม" ซึ่งเป็นเหตุผลของฟีเจอร์นี้
  source String @default("MANUAL")

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop        Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  keyword     AutoReplyKeyword?             @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  logs        AutoReplyLog[]
  fromQueue   AutoReplyUnansweredQuestion[]

  // คำถามซ้ำในกลุ่มเดียวกันต้องถูกปฏิเสธ — บังคับที่ DB ไม่พึ่งวินัยโค้ด (หลักเดียวกับ AutoReplyPhrase)
  // 🛑 unique ที่ระดับ "กลุ่ม" ไม่ใช่ "ร้าน" ตั้งใจ: คำถามเดียวกันอยู่ได้หลายกลุ่ม เพราะแต่ละกลุ่ม
  //    มีน้ำเสียง/กฎ/ขอบเขตของตัวเอง — ตอนจับคู่ใช้ตัวตัดสิน 3 ชั้น (DATABASE §3.9.1):
  //    keyword.priority → useCount → qna.id (ห้ามพึ่งลำดับที่ DB คืนมา)
  @@unique([keywordId, normalizedQuestion])
  // query หลักของ QnA matching: โหลดคลังที่เปิดใช้ของร้านในคิวรีเดียว (ตอน match ยังไม่รู้ว่ากลุ่มไหน)
  @@index([shopId, isActive])
  // หน้าจัดการรายกลุ่ม: เรียงตามที่ถูกใช้บ่อย + ตัวกรอง "ไม่เคยถูกใช้" (useCount = 0)
  @@index([keywordId, isActive, useCount])
}

/// คิว "คำถามที่ DeepBot ตอบไม่ได้" — ตารางจริงที่เขียนตอนเกิดเหตุ
///
/// 🛑 ทำไมไม่ groupBy บน AutoReplyLog ตอนเปิดหน้า (ทั้ง 3 ข้อทำให้ groupBy ใช้ไม่ได้ ไม่ใช่แค่ช้ากว่า):
///   1. AutoReplyLog ไม่มี index บน normalizedText และเป็นตารางที่โตเร็วที่สุดในระบบ
///   2. คิวต้องมีสถานะ (ข้าม/ตอบแล้ว) ซึ่งเก็บใน log ที่เป็น append-only ไม่ได้
///   3. ต้องกรอง PII **ตอนเขียน** — groupBy จะดึงที่อยู่/เบอร์ลูกค้าขึ้นมาโชว์ทุกครั้ง
///
/// ตัวกรองก่อนเขียน (DATABASE §3.10.1, ตายตัวในโค้ด ร้านแก้ไม่ได้): ยาว ≤3 ตัวอักษร ·
/// มีเลขติดกัน ≥9 ตัว · มีคำบ่งชี้ที่อยู่ · ยาวเกิน 80 ตัวอักษร — ข้อความที่ติดกรองไม่ถูกเขียนเลย
/// (ยังอยู่ใน AutoReplyLog ตามเดิม ไม่มีการลบข้อมูล มีแต่การไม่ทำสำเนาเพิ่ม)
model AutoReplyUnansweredQuestion {
  id     String @id @default(uuid())
  shopId String

  // normalize ด้วย normalizeMessage() ตัวเดียวกับทุกที่ — เป็นทั้งคีย์รวมแถวและตัวเทียบตอนแปลงเป็น QnA
  normalizedQuestion String @db.Text
  // ข้อความดิบตัวอย่างล่าสุด (ผ่านตัวกรองเดียวกันมาแล้ว) — คนอ่านรู้เรื่องกว่ารูป normalize
  rawSample          String @db.Text

  hitCount    Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  // "PENDING" = รอกรอกคำตอบ | "DISMISSED" = ร้านกดข้าม | "ANSWERED" = แปลงเป็น AutoReplyQna แล้ว
  //
  // 🛑 ถูกถามซ้ำหลังเป็น ANSWERED/DISMISSED แล้ว: hitCount++ และ lastSeenAt อัปเดตตามปกติ
  //    แต่ **ไม่เปลี่ยน status กลับ** — ถ้าตอบไปแล้วแต่ยังเข้ามาที่ NO_KEYWORD_MATCH อีก แปลว่า
  //    คำตอบที่กรอกไว้ยัง match ไม่ติด (พิมพ์ต่างกันนิดเดียว) ตัวเลขนี้คือหลักฐานว่าถึงเวลา
  //    เปิดโหมดความคล้ายแล้ว ถ้ารีเซ็ต status จะกลายเป็นคิวที่วนไม่จบและร้านจะเลิกเปิด
  status String @default("PENDING")

  // ชี้ข้อในคลังที่เกิดจากคิวแถวนี้ — SetNull เพราะลบข้อในคลังไม่ควรลบประวัติว่าเคยตอบไปแล้ว
  qnaId String?

  dismissedAt       DateTime?
  dismissedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  qna  AutoReplyQna? @relation(fields: [qnaId], references: [id], onDelete: SetNull)

  // 🛑 หัวใจของตาราง: ข้อความเดียวกันของร้านเดียวกัน = แถวเดียวตลอดกาล นับที่ hitCount
  //    ทำให้ upsert ในเส้นทางร้อนเป็น operation เดียวและกันคิวบวมโดยไม่ต้องมี dedupe ในโค้ด
  @@unique([shopId, normalizedQuestion])
  // หน้าคิว: ของร้านนี้ ที่ยังรอกรอก เรียงตามที่ถูกถามบ่อย
  @@index([shopId, status, hitCount])
}
