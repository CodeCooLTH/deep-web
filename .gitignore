# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# log ที่ redirect ออกมาเอง (เช่น `npm run build > b.log`) — เคยหลุดเข้า git มาแล้ว (48c0541b)
# และเป็นอันตรายจริง: Tailwind v4 สแกนไฟล์ในรีโปเป็น "ข้อความ" ถ้า log มีคลาส arbitrary value
# ที่ผิดไวยากรณ์อยู่ในนั้น มันจะถูกหยิบไปเจนเป็น CSS rule แล้ว dev พังทั้ง group
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads — โฟลเดอร์ไฟล์ของ STORAGE_DRIVER=local (dev) ที่ **root ของรีโปเท่านั้น**
# 🛑 ต้องมี `/` นำหน้า: เขียน `uploads/` เปล่า ๆ จะ match ทุกโฟลเดอร์ชื่อนี้ทุกความลึก —
# `src/app/api/uploads/` (route ticket/commit ของ direct upload) เคยถูกกลืนหายทั้งโฟลเดอร์
# ตอน `git add` เมื่อ 2026-08-10: tsc/เทสเขียวหมดเพราะไฟล์อยู่บนดิสก์ครบ แต่ถ้าหลุดไปถึง prod
# จะได้ 404 ทั้งฟีเจอร์โดยไม่มีอะไรฟ้อง (คลาสเดียวกับ root-served-assets-and-proxy.md)
/uploads/

# claude code local settings
.claude/
.env*.local

# QA screenshots (re-generated on demand) — safepay-qa เขียนที่ .screenshots/{YYYY}/{M}/{D}/ เท่านั้น (artifact ไม่ commit)
.screenshots/
# legacy/stray QA artifact dirs — กันเผลอ commit
docs/qa-screenshots/
qa-screenshots/
# root-catch: กัน QA เผลอเขียน qa-*.png ที่ root (อย่า commit artifact)
/qa-*.png

# editor / tool working dirs (ไม่ใช่ source — ไม่ commit)
.obsidian/
# .impeccable — แชร์เฉพาะไฟล์ที่ทีมต้องใช้ร่วมกัน (2026-07-31)
#   config.json = กฎ ignore ของ detector, design.json = design system (มี palette Paces ที่เพิ่มไว้)
#   ที่เหลือเป็นของเครื่องใครเครื่องมัน: cache, ผลรัน critique/live, ภาพหน้าจอ
#   config.local.json = ของส่วนตัวรายเครื่องโดยเจตนาของตัว skill เอง (เก็บ consent ฯลฯ)
.impeccable/*
!.impeccable/config.json
!.impeccable/design.json
.impeccable/config.local.json

# Playwright
/playwright-report/
/test-results/

# local image paste inbox
.img-inbox/
img

