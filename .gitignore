# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads
uploads/

# claude code local settings
.claude/
.env*.local

# QA screenshots (re-generated on demand) — safepay-qa ต้องเขียนที่ docs/qa-screenshots/ เท่านั้น
docs/qa-screenshots/
# root-catch: กัน QA เผลอเขียน qa-*.png ที่ root (อย่า commit artifact)
/qa-*.png
