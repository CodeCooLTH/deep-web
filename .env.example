# === Database ===
# Local (Docker): ชี้ไป postgres service
DATABASE_URL="postgresql://safepay:safepay@localhost:5432/safepay"
# Production (Supabase): pooler port 6543 + pgbouncer
# DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL ใช้ตอน migrate เท่านั้น (port 5432 ของ Supabase)
DIRECT_URL="postgresql://safepay:safepay@localhost:5432/safepay"

# === Auth ===
# รหัสผ่านเริ่มต้นสำหรับ admin — ต้องตั้งก่อนรัน seed (ห้ามเว้นว่าง)
ADMIN_DEFAULT_PASSWORD="change-me-in-production"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"
FACEBOOK_ID=""
FACEBOOK_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === apitel.co SMS Gateway (Real OTP) ===
# KEY และ SECRET หาได้จาก apitel.co dashboard (รูปแบบ UUID)
APITEL_API_KEY=
APITEL_API_SECRET=
# SENDER_NAME ต้องเป็นชื่อที่ apitel.co approve บน account นั้นแล้วเท่านั้น
# (ส่งชื่อที่ไม่ approve → apitel ตอบ 400 "Sender Name Invalid").
# เว้นว่าง = ใช้ default sender ของ account อัตโนมัติ (ปลอดภัยสุดถ้าไม่แน่ใจ)
APITEL_SENDER_NAME=
# BASE_URL ปกติไม่ต้องแก้ — มี default ในโค้ดอยู่แล้ว
APITEL_BASE_URL=https://api.apitel.co/sms

# === Storage driver ===
# local = ใช้ filesystem (./uploads) — เหมาะกับ dev/docker
# s3    = ใช้ S3-compatible (Supabase Storage S3 / AWS S3 / R2 / Spaces / MinIO)
STORAGE_DRIVER="local"

# === S3-compatible storage (เมื่อ STORAGE_DRIVER=s3) ===
# Supabase:            S3_ENDPOINT=https://xxx.supabase.co/storage/v1/s3  S3_FORCE_PATH_STYLE=true
# AWS S3:              S3_ENDPOINT=""  S3_FORCE_PATH_STYLE=false
# Cloudflare R2:       S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com  S3_FORCE_PATH_STYLE=true
# MinIO (local):       S3_ENDPOINT=http://localhost:9000  S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Public URL prefix สำหรับ object (ถ้า bucket เป็น public read)
# Supabase public: https://xxx.supabase.co/storage/v1/object/public/uploads
S3_PUBLIC_URL=""

# === URLs ===
# API_URL — server-side fetch ภายใน
API_URL="http://deepth.local:4000"
#
# Cross-subdomain absolute URLs — ใช้ใน admin pages (Users/Orders) เพื่อ
# เปิด tab ใหม่ไป /u/{username} หรือ /o/{token} บน buyer subdomain
# และใน buyer VerticalMenu "ไปหน้าร้านค้า"
# Dev:
NEXT_PUBLIC_BUYER_URL="http://deepth.local:4000"
NEXT_PUBLIC_SELLER_URL="http://seller.deepth.local:4000"
# Prod:
# NEXT_PUBLIC_BUYER_URL="https://deepthailand.app"
# NEXT_PUBLIC_SELLER_URL="https://seller.deepthailand.app"

# === SEO / Analytics ===
# Public site URL used for canonical, OG, sitemap, robots.host
NEXT_PUBLIC_SITE_URL="https://deepthailand.app"
# Google Analytics 4 — see analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-TB854DJZX4"
# Google Search Console HTML-tag verification — paste the content value after
# adding deepthailand.app as a property in search.google.com/search-console
NEXT_PUBLIC_GSC_VERIFICATION=""

# === feature 00018 Facebook/IG chat ===
FB_CHAT_APP_ID=
FB_CHAT_APP_SECRET=
FB_WEBHOOK_VERIFY_TOKEN=
# key 32 byte เป็น hex 64 ตัว — สร้างด้วย: openssl rand -hex 32
CHANNEL_TOKEN_KEY=

# AI ช่วยร่างคำตอบ (composer improvement #3) — Google Gemini
# GEMINI_API_KEY: จาก https://aistudio.google.com/apikey (server-only, ห้าม NEXT_PUBLIC_)
# ต้องตั้งใน Vercel env (Preview + Production) ด้วย ไม่งั้น API คืน 503 "ยังไม่พร้อมใช้งาน"
GEMINI_API_KEY=
# GEMINI_MODEL: ไม่บังคับ (default gemini-2.0-flash)
GEMINI_MODEL=

# feature 00043: Meta Human Agent (ตอบแชทเกิน 24 ชม. ได้ถึง 7 วัน)
# META_HUMAN_AGENT_ENABLED: สวิตช์ใหญ่ระดับระบบ — ค่าว่าง/ไม่ตั้ง = ปิดสนิท
#   เปิดได้ด้วยค่า 'true' เท่านั้น (เทียบสตริงตรง ๆ — 'True'/'1' ไม่นับว่าเปิด)
#   🛑 ห้ามตั้งเป็น true ก่อนได้รับอนุมัติ permission "human_agent" จาก Meta App
#   Review — เปิดก่อนได้รับอนุมัติแล้วยิง tag ออกไป Meta จะปฏิเสธทั้งข้อความ
#   ลูกค้าจริงจะไม่ได้รับข้อความนั้นเลย
META_HUMAN_AGENT_ENABLED=
# META_HUMAN_AGENT_TEST_PSIDS: allow-list บัญชีทดสอบ ใช้ระหว่างรอ Meta App
#   Review อนุมัติ permission ด้านบน — คั่นด้วย ','
#   ค่าที่ใส่คือ PSID/IGSID ของ "ลูกค้า" (ExternalContact.externalUserId)
#   ไม่ใช่รหัสเพจหรือรหัสร้าน เพราะสิทธิ์ Standard Access ผูกกับตัวตนของ
#   คู่สนทนา ไม่ใช่เพจที่เชื่อมอยู่
#   ไม่ตั้งค่า = ไม่มีใครอยู่ใน allow-list (fail-closed)
#   บัญชีที่ใส่ต้องมี role บนแอป Meta (Tester/Developer/Admin) ด้วย ถึงจะใช้ได้จริง
META_HUMAN_AGENT_TEST_PSIDS=

# ── feature 00022: เชื่อมระบบขนส่ง iShip ──────────────────────────────────────
# ร้านเป็นคนวาง token ของตัวเองผ่านหน้าตั้งค่า — ไม่มี token ระดับระบบใน env
# token ที่ร้านวางถูกเข้ารหัสด้วย CHANNEL_TOKEN_KEY ด้านบน (ตัวเดียวกับช่องทางแชท)
#
# ISHIP_BASE_URL: ไม่ตั้ง = ใช้ production ของ iShip (https://app.iship.cloud)
#   มีไว้เผื่อได้ระบบทดสอบ (UAT) มาภายหลัง — ปัจจุบันผู้ให้บริการยังไม่มีให้
ISHIP_BASE_URL=
# ISHIP_DRY_RUN=1 เปิดโหมดจำลอง: การเปิดพัสดุ/เรียกรถจะไม่ถูกส่งออกไปจริง
#   แต่คืนผลลัพธ์รูปเดียวกันเพื่อให้ทดสอบเส้นทางได้ครบโดยไม่เสียเงิน
#   ใช้ได้เฉพาะ dev/QA — บน production ตั้งไปก็ไม่มีผล (โค้ดเช็ค NODE_ENV ซ้ำอีกชั้น)
#   เหตุผลที่ต้องมี: ทุกครั้งที่เปิดพัสดุจริง = พัสดุจริง + ค่าใช้จ่ายจริงของร้าน
ISHIP_DRY_RUN=
# ISHIP_WEBHOOK_SECRET: สุ่มยาว >= 32 ตัว (openssl rand -hex 24)
#   ใช้ประกอบ URL ที่ร้านนำไปตั้งเป็น webhook ที่ iShip:
#     https://<domain>/api/webhooks/iship/<ISHIP_WEBHOOK_SECRET>
#   iShip ไม่ได้ประกาศว่ามีลายเซ็นยืนยันตัวตนหรือไม่ (OQ-1) — secret ใน path
#   จึงเป็นตัวยืนยันหลักในตอนนี้ ห้ามใช้ค่าเดียวกันระหว่าง dev กับ production
ISHIP_WEBHOOK_SECRET=
