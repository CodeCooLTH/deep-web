{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma migrate deploy && prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    { "path": "/api/cron/inventory-renewal", "schedule": "0 19 * * *" },
    { "path": "/api/cron/business-package-lifecycle", "schedule": "0 20 * * *" },
    { "path": "/api/cron/chat-response-metrics", "schedule": "0 21 * * *" }
  ]
}
